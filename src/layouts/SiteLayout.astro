---
// 変更履歴: 2026-11-11 公開SEO点検により、実内容に合う検索向け情報へ更新。
// 変更履歴: 2026-11-08 ページごとに複製されていたhead・ロゴ・ヘッダー・フッターを共通レイアウトへ集約。
// 変更履歴: 2026-11-11 全ページに明るい共通トーン・文字・余白を適用。
// 変更履歴: 2026-11-11 公開済み会社情報による構造化データと共有画像を追加。試作の正規先をホームへ統一。
// 変更履歴: 2026-11-14 日本語中心の簡素な本文表現を全公開ページで共有。
// 役割: サイト共通の見た目・書体・メタ情報・ナビを維持し、本文だけをページごとに差し替える。
import '../styles/global.css';
import '../styles/atmosphere.css';
import '../styles/minimal.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; homePage?: boolean; noindex?: boolean; breadcrumbs?: {name:string;path:string}[]; }
const { title, description, homePage = false, noindex = false, breadcrumbs = [] } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const canonical = new URL(noindex && homePage ? home : Astro.url.pathname, Astro.site ?? 'https://site-veil.com').toString();
const organizationRoot = new URL(home, Astro.site ?? 'https://site-veil.com').href;
const organizationSchema = {'@context':'https://schema.org','@graph':[
  {'@type':'Organization','@id':`${organizationRoot}#organization`,name:'SITEVEIL',legalName:'株式会社ライフキャスティングジャパン',url:organizationRoot,email:'info@site-veil.com',logo:new URL(`${home}brand/siteveil-horizontal-black.svg`,organizationRoot).href,address:{'@type':'PostalAddress',addressRegion:'愛知県',addressLocality:'大府市',addressCountry:'JP'}},
  {'@type':'WebSite','@id':`${organizationRoot}#website`,url:organizationRoot,name:'SITEVEIL',inLanguage:'ja',publisher:{'@id':`${organizationRoot}#organization`}},
  {'@type':'WebPage',url:canonical,name:title,description,inLanguage:'ja',isPartOf:{'@id':`${organizationRoot}#website`}},
  // 役割: 画面に表示するパンくずと同じ階層だけを検索エンジンへ伝える。
  ...(breadcrumbs.length>1?[{'@type':'BreadcrumbList',itemListElement:breadcrumbs.map((breadcrumb,index)=>({'@type':'ListItem',position:index+1,name:breadcrumb.name,item:new URL(breadcrumb.path,organizationRoot).href}))}]:[])
]};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SITEVEIL" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={new URL(`${home}images/services/websites.webp`,organizationRoot).href} />
    <meta property="og:image:alt" content="SITEVEILのウェブサイト制作・SEO対策・保守サービス" />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema).replace(/</g,'\u003c')} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[homePage ? 'page-home' : 'page-inner']}>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>import '../scripts/navigation';</script>
  </body>
</html>
