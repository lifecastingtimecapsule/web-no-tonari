---
// 変更履歴: 2026-11-08 ページごとに複製されていたhead・ロゴ・ヘッダー・フッターを共通レイアウトへ集約。
// 変更履歴: 2026-11-11 全ページに明るい共通トーン・文字・余白を適用。
// 役割: サイト共通の見た目・書体・メタ情報・ナビを維持し、本文だけをページごとに差し替える。
import '../styles/global.css';
import '../styles/atmosphere.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; homePage?: boolean; noindex?: boolean; }
const { title, description, homePage = false, noindex = false } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://lifecastingtimecapsule.github.io').toString();
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SITEVEIL" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@500;600;700;900&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[homePage ? 'page-home' : 'page-inner']}>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>import '../scripts/navigation';</script>
  </body>
</html>
