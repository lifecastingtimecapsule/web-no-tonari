---
// 変更履歴: 2026-11-09 長い啓発記事を、登録なしで一通のSMSを判断する体験に置換。
// 変更履歴: 2026-11-09 3つの場面を一問ずつ表示し、PHPリンクはサービス相談の文脈へ移動。
// 役割: 怪しい箇所の発見とリンクを開く疑似体験を提供。入力・外部接続・回答保存を行わない。
import '../styles/phishing-experience.css';
import { phishingScenarios } from '../data/phishing-scenarios';
---
<div class="phishing-quiz" data-phishing-quiz>
  <nav class="phishing-quiz__navigation" aria-label="体験の問題" data-phishing-navigation hidden><button type="button" data-phishing-previous disabled>前の問題</button><span data-phishing-progress role="status" aria-live="polite">問題 1 / 3</span><button type="button" data-phishing-next>次の問題</button></nav>
  {phishingScenarios.map((scenario, index) => <div class="phishing-experience" data-phishing-experience data-phishing-scenario={scenario.id} data-phishing-panel={index} hidden={index > 0}>

  <div class:list={["phishing-experience__stage", {"phishing-experience__stage--email": scenario.medium === "email"}]}>
    {scenario.medium === "sms" ? <figure class="phishing-phone">
      <figcaption class="visually-hidden">{scenario.subject}の学習用サンプル</figcaption>
      <div class="phishing-phone__status" aria-hidden="true"><span>9:41</span><i></i><svg width="42" height="16" viewBox="0 0 42 16" fill="none"><path d="M2 12V9M7 12V6M12 12V3" stroke="currentColor" stroke-width="3"/><rect x="23" y="3" width="15" height="10" rx="2" stroke="currentColor"/><path d="M40 6v4" stroke="currentColor" stroke-width="2"/></svg></div>
      <div class="phishing-phone__contact"><svg class="phishing-phone__back" aria-hidden="true" width="14" height="24" viewBox="0 0 14 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m10 3-8 9 8 9"/></svg><span class="phishing-phone__avatar" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3Z"/></svg></span><button type="button" class="phishing-point phishing-phone__sender" data-phishing-point="sender" aria-label={`${scenario.sender}の送信元が怪しいと思う`} aria-controls={`phishing-result-${scenario.id}`} disabled>{scenario.sender} <span aria-hidden="true">›</span></button></div>
      <div class="phishing-phone__conversation"><p class="phishing-phone__date">テキストメッセージ • SMS<br />本日 9:40</p><div class="phishing-phone__bubble"><p class="phishing-message-copy">{scenario.message}</p><button type="button" class="phishing-point" data-phishing-point="urgency" aria-label={`${scenario.urgency}が怪しいと思う`} aria-controls={`phishing-result-${scenario.id}`} disabled>{scenario.urgency}</button><button type="button" class="phishing-point phishing-phone__url" data-phishing-point="url" aria-label={`${scenario.url}のURLが怪しいと思う`} aria-controls={`phishing-result-${scenario.id}`} disabled>{scenario.url}</button><p>{scenario.ending}</p></div><p class="phishing-phone__sample">学習用サンプル</p></div>
      <div class="phishing-phone__composer" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/></svg><span>テキストメッセージ • SMS</span></div><div class="phishing-phone__home" aria-hidden="true"></div>
    </figure> : <figure class="phishing-mail"><figcaption>受信トレイ <span>学習用サンプル</span></figcaption><div class="phishing-mail__body"><p class="phishing-mail__subject">{scenario.subject}</p><p class="phishing-mail__label">差出人</p><button type="button" class="phishing-point phishing-mail__sender" data-phishing-point="sender" aria-label={`${scenario.sender}の差出人が怪しいと思う`} aria-controls={`phishing-result-${scenario.id}`} disabled>{scenario.sender}</button><p class="phishing-message-copy">{scenario.message}</p><button type="button" class="phishing-point" data-phishing-point="urgency" aria-label={`${scenario.urgency}が怪しいと思う`} aria-controls={`phishing-result-${scenario.id}`} disabled>{scenario.urgency}</button><button type="button" class="phishing-point phishing-phone__url" data-phishing-point="url" aria-label={`${scenario.url}の行き先を確かめる`} aria-controls={`phishing-result-${scenario.id}`} disabled>{scenario.url}</button><p>{scenario.ending}</p></div></figure>}

    <div class="phishing-experience__decision">
      <div data-phishing-intro><h3 data-phishing-question tabindex="-1">{scenario.title.split('、').map((line, index, lines) => <span>{line}{index < lines.length - 1 ? '、' : ''}</span>)}</h3><p>{scenario.prompt}</p><p class="phishing-experience__hint">{scenario.medium === "email" ? "差出人・文章・URLから選べます。" : "番号・文章・URLから選べます。"}</p></div>
      <div class="phishing-result" id={`phishing-result-${scenario.id}`} data-phishing-result hidden>
        <svg class="phishing-result__icon" aria-hidden="true" width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 3 38 9v12c0 10-10 17-16 20C16 38 6 31 6 21V9Z"/><path data-phishing-check d="m14 22 6 6 11-13"/><path data-phishing-cross d="m16 16 12 12m0-12L16 28"/></svg>
        <h3 data-phishing-title tabindex="-1"></h3><p data-phishing-explanation></p><p class="phishing-result__takeaway" data-phishing-takeaway></p><p class="phishing-experience__hint" data-phishing-simulation hidden>実際のサイトは開いていません。リンクを押しただけで情報が盗まれた、という意味ではありません。</p>
      </div>
      <div class="phishing-experience__actions"><button type="button" class="phishing-experience__answer" data-phishing-action="judge" aria-controls={`phishing-result-${scenario.id}`} disabled>フィッシングだと思う</button><button type="button" class="phishing-experience__open" data-phishing-action="open" aria-controls={`phishing-result-${scenario.id}`} disabled>リンクを開く（体験）</button></div>
      <button type="button" class="phishing-experience__reset" data-phishing-reset hidden>もう一度見る</button>
    </div>
  </div>
</div>)}
  <noscript><div class="phishing-quiz__fallback"><p>操作体験にはJavaScriptが必要です。3問の答えはこちらから読めます。</p>{phishingScenarios.map((scenario, index) => <details><summary>問題{index + 1}：{scenario.title}</summary><p>{scenario.responses.judge.explanation}</p><p>{scenario.responses.judge.takeaway}</p></details>)}</div></noscript>
  <div class="phishing-experience__footnote"><p>登録不要・情報の入力なし。番号・URL・青葉商事・KURASHIは教材用の例です。日本郵便・Appleの公式教材ではありません。</p><details><summary>出典と、実際に困ったときの確認先</summary><p><a href="https://www.post.japanpost.jp/notification/notice/fraud-mail.html">日本郵便の注意喚起・公式窓口</a> ／ <a href="https://www.npa.go.jp/bureau/cyber/countermeasures/phishing.html">警察庁のフィッシング対策</a></p><p>入力してしまった場合は、公式の窓口からパスワード変更やカード会社への連絡を。SMSの形式だけで偽物と決めつけず、利用したサービスの公式案内を確認します。</p></details></div>
</div>
<script>import '../scripts/phishing-experience';</script>
