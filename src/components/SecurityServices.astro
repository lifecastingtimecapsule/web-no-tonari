---
// 変更履歴 2026-11-20　価格比較用の一覧は金額と項目を一行にまとめて各プランに直接移動。
// 変更履歴: 2026-11-15 セキュリティ専門への転換に合わせ、確認・検査・保守だけを一覧化。
// 役割: 依頼内容と既存の税込価格を同じ場所で示し、詳細へ案内する。
import {pricingPlans,securityInvestigationPlans,emergencyMaintenancePlans,formatPrice} from '../data/pricing';
const home=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const securityServices=[
 {name:'サイトの安全チェック',price:'無料',description:'サイトのURLから、通信の暗号化やなりすましメール対策の設定を確認します。',path:'security/#site'},
 {name:'メールアドレスの漏えいチェック',price:'無料',description:'既知の漏えい記録の有無と、おおよその件数を表示します。',path:'security/#email'},
 ...pricingPlans.filter(plan=>plan.id==='email-breach-check').map(plan=>({name:'メール照会の郵送報告書（準備中）',price:formatPrice(plan.amount),description:'10アドレスまで。国内送料込み。',path:'pricing/#'+plan.id})),
 ...pricingPlans.filter(plan=>plan.id==='security').map(plan=>({name:plan.name,price:formatPrice(plan.amount)+'／1回',description:plan.summary,path:'pricing/#security'})),
 ...securityInvestigationPlans.map(plan=>({name:plan.name,price:formatPrice(plan.amount)+'〜／1回',description:plan.summary,path:'pricing/#'+plan.id})),
 ...pricingPlans.filter(plan=>plan.id==='maintenance').map(plan=>({name:plan.name,price:formatPrice(plan.amount)+'／月',description:plan.summary,path:'pricing/#maintenance'})),
 ...emergencyMaintenancePlans.map(plan=>({name:plan.name,price:formatPrice(plan.amount)+'〜／1回',description:plan.summary,path:'pricing/#'+plan.id})),
];
---
<div class:list={['security-services', {'price-index':compact}]}>
{securityServices.map(service=><a href={home+service.path}><div><h3>{service.name}</h3>{!compact && <p>{service.description}</p>}</div><strong>{service.price}</strong><span aria-hidden="true">→</span></a>)}
</div>
<style>
.security-services a{display:grid;grid-template-columns:minmax(0,1fr) auto 24px;gap:32px;align-items:center;color:var(--ink);text-decoration:none;padding:28px 0;border-top:1px solid var(--mist)}.security-services h3{font-size:21px;margin:0 0 10px;line-height:1.6}.security-services p{font-size:16px;color:var(--ink-muted);margin:0;line-height:1.8;max-width:40em}.security-services strong{font-size:20px;white-space:nowrap;font-variant-numeric:tabular-nums}.security-services a:focus-visible{outline:3px solid var(--signal);outline-offset:4px}.security-services a:hover h3{text-decoration:underline;text-underline-offset:6px}@media(max-width:700px){.security-services a{grid-template-columns:minmax(0,1fr) 24px;gap:16px}.security-services a>div{grid-column:1/-1}.security-services strong{font-size:19px}.security-services h3{font-size:21px}}
.price-index a{padding:12px 0}.price-index h3{margin:0;font-size:17px}.price-index strong{font-size:17px}@media(max-width:700px){.price-index a{grid-template-columns:minmax(0,1fr) auto;gap:10px}.price-index a>div{grid-column:auto}.price-index a>span{display:none}}
</style>
