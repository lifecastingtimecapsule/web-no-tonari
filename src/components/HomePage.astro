---
// 変更履歴 2026-11-20　相談内容、費用、報告の順に並べ、重複するサービス一覧を省いた。
// 変更履歴: 2026-11-15 セキュリティ専門のトップへ全面改稿。ヒーロー・問い合わせ・無料チェックの機能は維持。
// 変更履歴: 2026-11-15 固定したヒーローと安全チェックの後へ、単発・定期・更新・複製環境の境界を追加。
// 役割: 無料確認から有料検査・保守まで、対象と費用を理解して相談できる入口。
import SiteLayout from '../layouts/SiteLayout.astro';
import VeilHero from './VeilHero.astro';
import SafetyCheck from './SafetyCheck.astro';
import SecurityPositioning from './SecurityPositioning.astro';
// 変更履歴 2026-11-20　架空の報告見本に加え、許可された匿名改善事例を掲載。
import SecurityCase from './SecurityCase.astro';
import SecurityBoundaries from './SecurityBoundaries.astro';
import ContactForm from './ContactForm.astro';
import '../styles/home-continuity.css';
interface Props {preview?:boolean;}
const {preview=false}=Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/,'') + '/';
const faqs = [
  ['検査の日にサイトを止める必要はありますか？','普段の運営に合わせて調査の時間と方法を決めます。侵入テストは、書面で同意いただいた複製環境だけで行います。', 'clone-testing'],
  ['定期点検を頼むと、更新もしてもらえますか？','定期点検では変更点や更新の必要性をお知らせします。実際にソフトを更新する場合は、作業内容と費用を別途ご案内します。', 'update-boundary'],
  ['紙の報告書をもう一度受け取れますか？','発送から30日以内にご相談ください。再発行しても保管期限は延びません。期限後の再調査・再発行は別途有料です。', 'report-reissue'],
  ['中小企業は、セキュリティ対策を何から始めればいいですか？','まず公開されている情報の確認から始めます。通信の暗号化、ソフトの更新状況、バックアップ、パスワードの使い回し、公開ファイルの有無を確認し、費用をかける前に「今どこが危ないか」を整理します。サイトの安全チェックは無料で利用できます。', 'start-small'],
  ['セキュリティ診断の費用はいくらですか？','基本セキュリティ確認が59,400円、システム詳細検査が198,000円〜、システム総合検査・侵入テストが330,000円〜、基本保守が月9,240円です（すべて税込）。対象範囲と作業量で変わるため、事前にお見積りをお伝えします。', 'cost'],
  ['無料でできるセキュリティチェックはありますか？','サイトの安全チェックと、メールアドレスの漏えいチェックを無料で提供しています。どちらも登録不要で、公開されている情報だけを確認します。攻撃や侵入の試行は行いません。', 'free-check'],
  ['情報漏えいが起きていないか、自分で確認できますか？','公開されている漏えい記録の照会と、社内での不審なログの確認から始められます。ただし、照会で見つからない場合でも漏えいが無いと断定はできません。判断に迷う場合はご相談ください。', 'breach-check'],
  ['メールアドレスが漏えいしていないか確認できますか？','無料のメール漏えいチェックで、公開されている漏えい記録を照会できます。パスワードは入力しないでください。照会結果は件数の区分で表示し、保存はしません。', 'email-breach'],
  ['WordPressのセキュリティは、何を見ればいいですか？','ソフトとプラグインの更新状況、管理画面のURL、公開されているファイル、不審なユーザーの有無を確認します。無料のサイトチェックでも一部は確認できますが、設定の詳細は有料の確認で調べます。', 'wordpress'],
  ['サイバー保険に入る前に、何をすればいいですか？','保険の前に、公開情報と基本設定を確認し、事故が起きたときの連絡先と初動を決めておくと説明しやすくなります。保険の引受可否や条件は各保険会社の判断です。', 'cyber-insurance'],
  ['補助金や助成金は使えますか？','制度は年度や自治体で変わります。対象になるかは最新の公募要領と申請要件で確認が必要です。当社は申請書類の整理を支援しますが、採択を保証するものではありません。', 'subsidy'],
];
---
<SiteLayout title="セキュリティ検査・保守・漏えいチェック｜SITEVEIL" description="小さな会社のセキュリティを、分かる言葉で。無料のサイト・メール漏えいチェック、基本確認59,400円、詳細検査198,000円〜、侵入テスト330,000円〜、保守月9,240円。税込。対象と費用を合意して調査します。" homePage noindex={preview} faq={faqs.map(([question,answer])=>({question,answer}))}>
<VeilHero/><SafetyCheck/><SecurityPositioning/>
<SecurityCase/>
<SecurityBoundaries/>
<section class="faq section" id="faq" aria-labelledby="faq-title"><div class="shell faq__layout"><div class="section-heading"><h2 id="faq-title">よくある質問</h2><p class="reader-faq-links"><a href={home + 'service-specification/'}>サービス仕様</a>・<a href={home + 'terms/'}>利用規約</a></p></div><div class="faq-list">{faqs.map(([question,answer,id])=><details id={id}><summary>{question}<span aria-hidden="true"></span></summary><div class="faq-list__answer"><p>{answer}</p></div></details>)}</div></div></section>
<section class="contact section" id="contact" aria-labelledby="contact-title"><div class="shell contact__layout"><div class="contact__intro"><h2 id="contact-title">お問い合わせ</h2></div><ContactForm/></div></section>
<script>import '../scripts/site';</script>
</SiteLayout>
<!-- 試作の役割: アンカー移動も待たせず、素早い往復操作をそのまま反映する。 -->
<style is:global>html:has([data-veil-stage]) { scroll-behavior: auto; }
html:has([data-veil-stage]) .site-header { border:0; border-radius:0; box-shadow:none; background:transparent; top:0; width:100%; min-height:76px; padding:16px 4%; }html:has([data-brand-observed]) .site-header .brand { opacity:0; visibility:hidden; transition:none; }
html:has([data-brand-visible]) .site-header .brand { opacity:1; visibility:visible; }
@media(prefers-reduced-motion:reduce){html:has([data-veil-stage]) .site-header .brand { transition:none; }}
</style>

<style is:global>html:has([data-hero-passed]) .site-header { background:#fff; } html:has([data-veil-stage]) .site-nav { gap:28px; } html:has([data-veil-stage]) .nav-contact { background:transparent; color:var(--ink); padding:10px 0; border-radius:0; } @media(max-width:900px){html:has([data-veil-stage]) .site-nav {gap:0; background:#fff;}}</style>
