---
// 変更履歴: 2026-11-15 セキュリティ専門のトップへ全面改稿。ヒーロー・問い合わせ・無料チェックの機能は維持。
// 役割: 無料確認から有料検査・保守まで、対象と費用を理解して相談できる入口。
import SiteLayout from '../layouts/SiteLayout.astro';
import VeilHero from './VeilHero.astro';
import SafetyCheck from './SafetyCheck.astro';
import SecurityServices from './SecurityServices.astro';
import ContactForm from './ContactForm.astro';
import '../styles/home-continuity.css';
interface Props {preview?:boolean;}
const {preview=false}=Astro.props;
const faqs=[
 ['何を頼めばよいか分からなくても相談できますか？','はい。管理の状況や気になっていることから、必要な確認と費用を整理します。'],
 ['無料チェックと有料検査は何が違いますか？','無料は公開情報や既知の漏えい記録の確認です。有料は事前に合意した設定・資料・コードなどを調査します。侵入テストは別のプランです。'],
 ['問題が見つかった後の修正も含まれますか？','検査料金には修正・復旧・再検査を含みません。必要な作業と費用を別途ご案内します。PHP・WordPress更新は専用プランで承ります。'],
 ['調査は許可した範囲だけで行いますか？','対象・操作・検査環境・停止条件を事前に書面で合意します。第三者のシステムや、許可されていない範囲は調査しません。'],
 ['結果はどう受け取れますか？','有料の基本確認・詳細検査・総合検査は、方法と結果をまとめた書面を国内郵送します。調査データは発送後30日で削除します。無料チェックは画面上で確認できます。'],
];
---
<SiteLayout title="セキュリティ検査・保守・漏えいチェック｜SITEVEIL" description="小さな会社のセキュリティを、分かる言葉で。無料のサイト・メール漏えいチェック、基本確認59,400円、詳細検査198,000円〜、侵入テスト330,000円〜、保守月9,240円。税込。対象と費用を合意して調査します。" homePage noindex={preview}>
<VeilHero/><SafetyCheck/>
<section class="services section" id="services" aria-labelledby="services-title"><div class="shell"><div class="section-heading"><h2 id="services-title">確かめる。<br/>守り続ける。</h2></div><SecurityServices/><p>表示はすべて税込。対象と費用は作業前に合意します。</p></div></section>
<section class="security section" aria-labelledby="security-title"><div class="shell security__layout"><div><h2 id="security-title">何を調べたかまで、<br/>きちんと残す。</h2><p>問題の有無だけでなく、調査した範囲と方法、分かったこと、まだ分からないことを書面にまとめます。</p></div><ul class="security__checks"><li><span aria-hidden="true"></span>対象と許可範囲を事前に合意</li><li><span aria-hidden="true"></span>根拠と対応の優先順位をご報告</li><li><span aria-hidden="true"></span>検査報告書を国内郵送</li><li><span aria-hidden="true"></span>発送後30日で調査データを削除</li></ul></div></section>
<section class="faq section" id="faq" aria-labelledby="faq-title"><div class="shell faq__layout"><div class="section-heading"><h2 id="faq-title">よくある質問</h2></div><div class="faq-list">{faqs.map(([question,answer])=><details><summary>{question}<span aria-hidden="true"></span></summary><div class="faq-list__answer"><p>{answer}</p></div></details>)}</div></div></section>
<section class="contact section" id="contact" aria-labelledby="contact-title"><div class="shell contact__layout"><div class="contact__intro"><h2 id="contact-title">お問い合わせ</h2></div><ContactForm/></div></section>
<script>import '../scripts/site';</script>
</SiteLayout>
<!-- 試作の役割: アンカー移動も待たせず、素早い往復操作をそのまま反映する。 -->
<style is:global>html:has([data-veil-stage]) { scroll-behavior: auto; }
html:has([data-veil-stage]) .site-header { border:0; border-radius:0; box-shadow:none; background:transparent; top:0; width:100%; min-height:76px; padding:16px 4%; }html:has([data-brand-observed]) .site-header .brand { opacity:0; visibility:hidden; transition:none; }
html:has([data-brand-visible]) .site-header .brand { opacity:1; visibility:visible; }
@media(prefers-reduced-motion:reduce){html:has([data-veil-stage]) .site-header .brand { transition:none; }}
</style>

<style is:global>html:has([data-hero-passed]) .site-header { background:#fff; } html:has([data-veil-stage]) .site-nav { gap:28px; } html:has([data-veil-stage]) .nav-contact { background:transparent; color:var(--ink); padding:10px 0; border-radius:0; } @media(max-width:900px){html:has([data-veil-stage]) .site-nav {gap:0; background:#fff;}}</style>
