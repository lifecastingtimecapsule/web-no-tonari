---
// 変更履歴: 2026-11-11 説明カード中心の試作を撤回。巨大な文字と流動的なインクのヒーローへ更新。
// 変更履歴: 2026-11-11 英語コピーを削除し、ヒーローもVの切れ目がある正式な文字ロゴに統一。
// 変更履歴: 2026-11-11 明るいインクと黒い正式ロゴに変更。行き先をヒーロー直下にそろえ、重複する相談ボタンを撤去。
// 変更履歴: 2026-11-11 安全チェックを画像付きの独立コンポーネントへ移管し、ヒーローと分離。
// 変更履歴: 2026-11-11 ユーザー指定により右下の停止ボタンを撤去。OS設定での動作制御は維持。
// 役割: 最小限の言葉と触覚的な表現でSITEVEILの印象をつくり、通常のサービス・相談導線へつなぐ。
const brandBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<section class="ink-hero" id="top" aria-labelledby="hero-title" data-veil-stage>
  <img class="ink-hero__fallback" src={`${brandBase}brand/ink-static.svg`} alt="" aria-hidden="true" />
  <canvas class="ink-hero__canvas" aria-hidden="true" data-ink-canvas></canvas>
  <div class="ink-hero__intro">
    <h1 id="hero-title">ウェブと、その先。</h1>
  </div>
  <img class="ink-hero__word" src={`${brandBase}brand/siteveil-wordmark-black.svg`} width="424" height="72" alt="" aria-hidden="true" />
  <div class="ink-hero__bottom">
    <a class="ink-hero__discover" href="#after-hero">つくる。守る。育てる。<span aria-hidden="true">↘</span></a>
  </div>
</section>
<script>import '../scripts/veil-motion';</script>
<style>
  .ink-hero{position:relative;isolation:isolate;height:100svh;min-height:630px;max-height:1100px;overflow:hidden;background:#f5f5f2;color:#16191d}
  .ink-hero__canvas,.ink-hero__fallback{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:-1}
  .ink-hero__fallback{background:#f5f5f2;object-fit:cover}
  .ink-hero__canvas{opacity:0}.ink-hero[data-ink-ready] .ink-hero__canvas{opacity:1}
  .ink-hero__intro{color:#16191d;position:absolute;left:4%;right:4%;top:22%;display:flex;justify-content:space-between;align-items:start;gap:24px}
  .ink-hero__intro h1{font-size:clamp(22px,2.7vw,44px);line-height:1.2;font-weight:700;letter-spacing:-.045em;margin:0}
  .ink-hero__intro p{font-size:14px;line-height:1.5;margin:0;font-weight:500}
  .ink-hero__word{position:absolute;left:3%;top:50%;translate:0 -50%;width:94%;height:auto;pointer-events:none;user-select:none}
  .ink-hero__bottom{position:absolute;left:4%;right:4%;bottom:8%;display:flex;justify-content:space-between;align-items:center;gap:24px}
  .ink-hero__bottom a{display:flex;align-items:center;justify-content:space-between;gap:36px;padding:14px 0;font-size:15px;color:#16191d;text-decoration:none;font-weight:700;position:relative}
  .ink-hero__contact{background:#16191d!important;color:#fff!important;padding:17px 24px!important;border-radius:0}
  .ink-hero__discover{color:#16191d!important}
  .ink-hero__bottom span{font-size:23px;line-height:1}

  a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #e22336;outline-offset:5px}button:active,.ink-hero__contact:active{translate:0 1px}
  @media(max-width:800px){.ink-hero{min-height:580px;max-height:950px}.ink-hero__intro{top:24%;display:block}.ink-hero__intro h1{font-size:28px}.ink-hero__intro p{font-size:12px;margin-top:12px}.ink-hero__word{top:49%;font-size:23vw}.ink-hero__bottom{bottom:12%;align-items:start;flex-direction:column;gap:18px}.ink-hero__bottom a{font-size:14px}}
</style>
