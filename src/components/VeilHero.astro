---
// 変更履歴: 2026-11-11 説明カード中心の試作を撤回。巨大な文字と流動的なインクのヒーローへ更新。
// 変更履歴: 2026-11-11 英語コピーを削除し、ヒーローもVの切れ目がある正式な文字ロゴに統一。
// 変更履歴: 2026-11-11 明るいインクと黒い正式ロゴに変更。行き先をヒーロー直下にそろえ、重複する相談ボタンを撤去。
// 変更履歴: 2026-11-11 安全チェックを画像付きの独立コンポーネントへ移管し、ヒーローと分離。
// 変更履歴: 2026-11-11 ユーザー指定により右下の停止ボタンを撤去。OS設定での動作制御は維持。
// 変更履歴: 2026-11-11 下部コピーを削除し、中央の細線矢印リンクへ統一。タップ領域と読み上げ名は維持。
// 変更履歴: 2026-11-11 背景色を白へ変更し、本文とナビに連続させる。顔料の色味は維持。
// 役割: 最小限の言葉と触覚的な表現でSITEVEILの印象をつくり、通常のサービス・相談導線へつなぐ。
const brandBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<section class="ink-hero" id="top" aria-labelledby="hero-title" data-veil-stage>
  <img class="ink-hero__fallback" src={`${brandBase}brand/ink-static.svg`} alt="" aria-hidden="true" />
  <canvas class="ink-hero__canvas" aria-hidden="true" data-ink-canvas></canvas>
  <div class="ink-hero__intro">
    <h1 id="hero-title">ウェブと、その先。</h1>
  </div>
  <img class="ink-hero__word" src={`${brandBase}brand/siteveil-wordmark-black.svg`} width="424" height="72" alt="" aria-hidden="true" />
  <div class="ink-hero__bottom">
    <a class="ink-hero__discover" href="#after-hero" aria-label="下のコンテンツへ"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 5v21M7 17l9 9 9-9" /></svg></a>
  </div>
</section>
<script>import '../scripts/veil-motion';</script>
<style>
  .ink-hero{position:relative;isolation:isolate;height:100svh;min-height:630px;max-height:1100px;overflow:hidden;background:#fff;color:#16191d}
  .ink-hero__canvas,.ink-hero__fallback{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:-1}
  .ink-hero__fallback{background:#fff;object-fit:cover}
  .ink-hero__canvas{opacity:0}.ink-hero[data-ink-ready] .ink-hero__canvas{opacity:1}
  .ink-hero__intro{color:#16191d;position:absolute;left:4%;right:4%;top:22%;display:flex;justify-content:space-between;align-items:start;gap:24px}
  .ink-hero__intro h1{font-size:clamp(22px,2.7vw,44px);line-height:1.2;font-weight:700;letter-spacing:-.045em;margin:0}
  .ink-hero__intro p{font-size:14px;line-height:1.5;margin:0;font-weight:500}
  .ink-hero__word{position:absolute;left:3%;top:50%;translate:0 -50%;width:94%;height:auto;pointer-events:none;user-select:none}
  .ink-hero__bottom{position:absolute;left:0;right:0;bottom:7%;display:flex;justify-content:center;pointer-events:none}
  .ink-hero__discover{display:grid;place-items:center;width:56px;height:56px;border:1px solid rgb(22 25 29 / .25);border-radius:50%;color:#16191d!important;text-decoration:none;pointer-events:auto;transition:background-color 180ms ease,border-color 180ms ease}
  .ink-hero__discover svg{width:27px;height:27px;fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round;transition:transform 180ms ease}
  @media(hover:hover){.ink-hero__discover:hover{background:rgb(255 255 255 / .55);border-color:#16191d}.ink-hero__discover:hover svg{transform:translateY(3px)}}
  .ink-hero__discover:active{background:rgb(255 255 255 / .65)}
  a:focus-visible{outline:3px solid #e22336;outline-offset:5px}
  @media(prefers-reduced-motion:reduce){.ink-hero__discover,.ink-hero__discover svg{transition:none}}
  @media(max-width:800px){.ink-hero{min-height:580px;max-height:950px}.ink-hero__intro{top:24%;display:block}.ink-hero__intro h1{font-size:28px}.ink-hero__intro p{font-size:12px;margin-top:12px}.ink-hero__word{top:49%;font-size:23vw}.ink-hero__bottom{bottom:8%}}
</style>
