---
// 変更履歴: 2026-11-11 Ink Revealを参考に独自の覆い・即時切替の試作を追加。操作を演出の完了待ちにしない。
// 役割: SITEVEILの制作・保守・調査を一つの体験で見せ、通常の安全チェックへ案内する。
const serviceBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const scenes = [
  { id: 'create', label: 'つくる', title: '伝わるかたちへ。', detail: 'ウェブサイト・AIアプリ', href: '/services/websites/' },
  { id: 'protect', label: '守る', title: '見えない不安を、見える情報へ。', detail: '安全性の確認・漏えい履歴の調査', href: '/security/' },
  { id: 'grow', label: '育てる', title: '公開した、その先も。', detail: '更新・保守・日々の改善', href: '/services/security/' },
];
---
<section class="veil-hero" id="top" aria-labelledby="hero-title">
  <div class="shell veil-hero__intro">
    <h1 id="hero-title">ウェブの心配を、<br />仕事からなくす。</h1>
    <div class="veil-hero__summary">
      <p>つくるところから、守り続けるところまで。<br />ウェブとAIを、あなたの仕事の力に。</p>
      <div class="veil-hero__links"><a href="#services">できることを見る <span aria-hidden="true">↘</span></a><a href="#contact">相談する <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>

  <div class="veil-stage shell" data-veil-stage>
    <div class="veil-stage__surface">
      <div class="veil-stage__veil veil-stage__veil--top" aria-hidden="true" data-veil-top></div>
      <div class="veil-stage__veil veil-stage__veil--bottom" aria-hidden="true" data-veil-bottom></div>
      <div class="veil-stage__brand" aria-hidden="true">SITEVEIL</div>
      <div class="veil-stage__scenes">
        {scenes.map((scene, index) => (
          <section class="veil-scene" data-veil-scene={scene.id} aria-labelledby={`veil-title-${scene.id}`} hidden={index !== 0}>
            <div class="veil-scene__copy">
              <p>{scene.detail}</p>
              <h2 id={`veil-title-${scene.id}`}>{scene.title}</h2>
              <a href={`${serviceBase}${scene.href}`}>詳しく見る <span aria-hidden="true">↗</span></a>
            </div>
            <div class={`veil-sample veil-sample--${scene.id}`} aria-label={`${scene.label}の説明用サンプル`}>
              <p class="veil-sample__caption">説明用サンプル</p>
              {scene.id === 'create' && <div class="veil-design"><div class="veil-design__name">余白のある、<br />いい仕事を。</div><div class="veil-design__art" aria-hidden="true"><span></span><span></span><span></span></div><div class="veil-design__footer">会社の魅力を、伝わるサイトに。</div></div>}
              {scene.id === 'protect' && <div class="veil-report"><h3>調査結果を、ひと目で。</h3><p>sample@example.com</p><div><span>サービス</span><strong>Sample Service</strong></div><div><span>メールアドレス</span><strong>●</strong></div><div><span>パスワード情報</span><strong>●</strong></div><small>架空データによる報告書の表示例</small></div>}
              {scene.id === 'grow' && <div class="veil-work"><h3>今日も、安心して<br />仕事を始める。</h3><div><span>サイトの更新</span><strong>確認済み</strong></div><div><span>バックアップ</span><strong>確認済み</strong></div><div><span>次の改善</span><strong>相談する</strong></div><small>運用イメージ・実測値ではありません</small></div>}
            </div>
          </section>
        ))}
      </div>
    </div>
    <div class="veil-stage__controls">
      <div class="veil-stage__choices" role="group" aria-label="紹介するサービスを選ぶ">
        {scenes.map((scene, index) => <button type="button" data-veil-choice={scene.id} aria-pressed={index === 0 ? 'true' : 'false'}>{scene.label}<span aria-hidden="true">↗</span></button>)}
      </div>
      <button class="veil-stage__motion" type="button" data-veil-motion aria-pressed="false" hidden>動きを止める</button>
    </div>
  </div>

  <div class="shell veil-check">
    <div><h2>いまのサイトを、先に確かめる。</h2><p id="safety-check-note">無料・登録不要。通信の暗号化や、なりすましメール対策などを確認します。</p></div>
    <div>
      <form data-safety-check-form novalidate>
        <label class="veil-check__label" for="safety-check-url">安全性を確認したいサイトのURL</label>
        <div class="veil-check__input"><input id="safety-check-url" name="safetyCheckUrl" type="url" inputmode="url" autocomplete="url" spellcheck="false" placeholder="example.com" aria-describedby="safety-check-note safety-check-status" required /><button type="submit">安全チェック <span aria-hidden="true">↗</span></button></div>
      </form>
      <p id="safety-check-status" role="status" data-safety-check-status></p>
    </div>
  </div>
</section>
<script>import '../scripts/veil-motion';</script>
<style>
  .veil-hero{padding-top:155px;color:var(--ink)}
  .veil-hero__intro{display:grid;grid-template-columns:1.25fr 1fr;gap:48px;align-items:end;padding-bottom:48px}
  h1{font-size:clamp(2.9rem,5.1vw,5rem);line-height:1.16;letter-spacing:-.055em;margin:0;font-weight:900}
  .veil-hero__summary{max-width:440px;justify-self:end}.veil-hero__summary>p{font-size:17px;line-height:1.9;margin:0 0 26px}
  .veil-hero__links{display:flex;gap:32px}.veil-hero__links a{font-weight:700;text-decoration:none;padding:10px 0}.veil-hero__links span{margin-left:20px;color:var(--signal)}
  .veil-stage__surface{position:relative;isolation:isolate;background:#16191d;color:#fff;min-height:510px;overflow:hidden}
  .veil-stage__brand{position:absolute;bottom:-.09em;left:.025em;font-size:clamp(100px,17.2vw,265px);line-height:1;font-weight:900;letter-spacing:-.065em;color:#33363a;pointer-events:none;user-select:none}
  .veil-stage__veil{position:absolute;background:var(--signal);pointer-events:none;z-index:-1;will-change:auto}
  .veil-stage__veil--top{width:78%;height:125%;right:-29%;top:-55%;border-radius:43% 0 50% 54%;rotate:-24deg}
  .veil-stage__veil--bottom{width:70%;height:90%;left:-42%;bottom:-70%;border-radius:44% 58% 0 0;rotate:-26deg}
  .veil-stage__scenes{position:relative;padding:55px 7% 100px}
  .veil-scene:not([hidden]){display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;min-height:355px}.veil-scene[hidden]{display:none}
  .veil-scene__copy>p{font-size:15px;margin:0 0 24px;color:#d4d6da}.veil-scene__copy h2{font-size:clamp(2rem,3.4vw,3.25rem);line-height:1.35;letter-spacing:-.04em;max-width:11em;margin:0 0 28px}.veil-scene__copy>a{color:white;font-size:15px;font-weight:700;text-decoration:none;display:inline-block;padding:12px 0}.veil-scene__copy>a span{margin-left:36px}
  .veil-sample{position:relative;background:#f3f3f0;color:#16191d;min-height:300px;transform:rotate(-4deg);padding:26px 28px 23px;max-width:415px;width:100%;justify-self:end}
  .veil-sample__caption{font-size:11px;color:#575a5f;margin:0 0 14px}.veil-design__name{font-size:32px;line-height:1.3;font-weight:700;letter-spacing:-.04em}.veil-design__art{height:100px;display:flex;justify-content:flex-end;align-items:center;overflow:hidden}.veil-design__art span{width:76px;height:76px;background:#e22336;rotate:-25deg;margin-left:-30px;border-radius:50% 0 50% 50%}.veil-design__art span:nth-child(2){background:#16191d;rotate:20deg}.veil-design__art span:nth-child(3){background:#a9aaa5;rotate:60deg}.veil-design__footer{font-size:12px;font-weight:500}
  .veil-report h3,.veil-work h3{font-size:24px;line-height:1.4;letter-spacing:-.035em;margin:0 0 16px}.veil-report>p{font-size:13px;margin:0 0 16px}.veil-report>div,.veil-work>div{display:flex;justify-content:space-between;align-items:center;padding:10px 0;font-size:12px;gap:12px}.veil-report strong{color:#bc162b}.veil-report small,.veil-work small{display:block;font-size:10px;margin-top:15px;color:#575a5f}.veil-work strong{background:#e3e6df;padding:4px 8px;font-size:10px}
  .veil-stage__controls{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-top:16px}.veil-stage__choices{display:flex;gap:8px}.veil-stage__choices button{border:0;background:#f0f0ef;color:#16191d;font:inherit;font-size:16px;font-weight:700;min-height:52px;padding:10px 24px;cursor:pointer}.veil-stage__choices button[aria-pressed=true]{background:#16191d;color:white}.veil-stage__choices span{margin-left:30px}.veil-stage__motion{background:none;border:0;padding:12px 0;font:inherit;font-size:12px;cursor:pointer;text-decoration:underline;text-underline-offset:4px}
  .veil-check{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-top:64px;padding-bottom:60px}.veil-check h2{font-size:22px;letter-spacing:-.025em;margin:0 0 12px}.veil-check p{font-size:13px;line-height:1.8;margin:0;color:#575a5f}.veil-check__label{display:block;font-size:12px;margin-bottom:10px}.veil-check__input{display:flex;gap:8px;background:#f1f1f0;padding:7px}.veil-check input{width:0;min-width:0;flex:1;font:inherit;font-size:16px;border:0;background:transparent;padding:12px;color:#16191d}.veil-check button{border:0;background:var(--signal);color:white;font:inherit;font-weight:700;font-size:13px;padding:14px 20px;white-space:nowrap;cursor:pointer}.veil-check button span{margin-left:12px}#safety-check-status{min-height:1.8em;margin-top:8px}
  button:active{transform:translateY(1px)}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #e32239;outline-offset:5px}.veil-stage a:focus-visible{outline-color:#fff}
  @media(prefers-reduced-motion:no-preference){.veil-stage__veil--top{animation:veil-open 700ms cubic-bezier(.16,1,.3,1) both}@keyframes veil-open{from{translate:12% -8%;rotate:-10deg}to{translate:0 0;rotate:-24deg}}}
  [data-veil-paused] .veil-stage__veil{animation:none}
  @media(max-width:800px){.veil-hero{padding-top:135px}.veil-hero__intro{grid-template-columns:1fr;gap:24px;padding-bottom:32px}.veil-hero__summary{justify-self:start;max-width:none}.veil-hero__summary>p{font-size:15px;margin-bottom:14px}.veil-stage__surface{min-height:570px}.veil-stage__scenes{padding:30px 24px 70px}.veil-scene:not([hidden]){grid-template-columns:1fr;gap:28px}.veil-scene__copy h2{font-size:28px;max-width:none;margin-bottom:8px}.veil-scene__copy>p{font-size:12px;margin-bottom:12px}.veil-scene__copy>a{font-size:13px;padding:8px 0}.veil-sample{width:86%;min-height:250px;padding:22px;justify-self:center;transform:rotate(-3deg)}.veil-design__name{font-size:26px}.veil-design__art{height:70px}.veil-stage__brand{font-size:18vw;bottom:0}.veil-stage__veil--top{width:120%;height:100%;right:-70%;top:-35%}.veil-stage__controls{align-items:flex-start;gap:10px}.veil-stage__choices{gap:5px}.veil-stage__choices button{padding:10px 14px;font-size:14px}.veil-stage__choices span{margin-left:10px}.veil-stage__motion{font-size:11px;max-width:75px}.veil-check{grid-template-columns:1fr;gap:20px;margin-top:44px;padding-bottom:35px}.veil-check h2{font-size:19px}}
  @media(max-width:800px){h1{font-size:clamp(1.85rem,7.7vw,3.5rem)}.veil-stage{display:flex;flex-direction:column}.veil-stage__controls{order:-1;padding:0 0 14px;flex-direction:column;gap:4px}.veil-stage__choices{width:100%}.veil-stage__choices button{flex:1;white-space:nowrap}.veil-stage__motion{align-self:end;max-width:none;min-height:44px}}
  @media(max-width:380px){.veil-stage__choices button{padding-inline:10px}.veil-stage__scenes{padding-inline:18px}.veil-check button{padding-inline:12px}.veil-check button span{margin-left:6px}}
</style>
