---
// 変更履歴: 2026-11-09 セキュリティを独立した一問体験へ移し、ここはEC記事だけに整理。
// 役割: ECの決済・在庫・返品の3問と、弊社の設計方針を表示する。
import { ecColumns } from '../data/learning-columns';
import '../styles/website-demo.css';
import '../styles/service-learning.css';
interface Props { slug: 'ec' }
const { slug } = Astro.props;
const columns = ecColumns;
---
<article class="website-demo service-learning" data-website-demo aria-labelledby="ec-learning-title">
  <header class="learning-intro"><h2 id="ec-learning-title">注文のあとまで、<br />弊社が設計で大切にすること。</h2><p>売れたあとに、現場が迷わず動けるか。決済の確定、在庫の確保、返品後の処理を、3つの運用判断から掘り下げます。</p><p class="learning-note">架空の運用例です。実際の状態名・処理のタイミングは、利用するECサービスや契約条件に合わせて確認します。</p></header>
  {columns.map((column, index) => <section class="design-question" id={`learn-${slug}-${column.id}`} data-design-question aria-labelledby={`learning-title-${column.id}`}>
    <header class="design-question__heading"><span aria-hidden="true">{index + 1}</span><h3 id={`learning-title-${column.id}`}>{column.title}</h3></header>
    <p class="design-question__prompt">{column.prompt}</p>
    <div class="design-question__options">
      {column.examples.map((lines, optionIndex) => <div class="design-option"><div class="design-option__example learning-option"><span class="design-option__letter">{optionIndex === 0 ? 'A' : 'B'}</span><div>{lines.map((line, lineIndex) => <p class:list={{ 'learning-option__lead': lineIndex === 0 }}>{line}</p>)}</div></div><button class="design-option__choose" type="button" data-design-choice={optionIndex === 0 ? 'A' : 'B'} aria-label={`問題${index + 1}：${optionIndex === 0 ? 'A' : 'B'}を選ぶ`} aria-controls={`learning-answer-${column.id}`} aria-pressed="false" disabled>{optionIndex === 0 ? 'A' : 'B'}を選ぶ</button></div>)}
    </div>
    <p class="design-question__feedback" data-choice-feedback role="status" aria-live="polite"></p>
    <details class="design-answer" id={`learning-answer-${column.id}`}><summary>設計の考え方を読む</summary><div class="design-answer__body"><p class="design-answer__choice">この例では、{column.choice}を選びます。</p><h4>{column.heading}</h4><p>{column.body}</p><div class="design-answer__practice"><h5>弊社が設計で確認すること</h5><p>{column.tip}</p></div>{column.source && <p class="learning-source">参考：<a href={column.source[1]}>{column.source[0]}</a></p>}</div></details>
  </section>)}
  <section class="learning-reading"><h3>お店は、公開してからも続いていく。</h3><p>制作費に加え、利用するECサービスの月額料金や決済手数料、配送費も確認します。受注・倉庫・経理がどう引き継ぐか、誰が返金を承認するかまで整理し、既存サービスの標準機能と必要な追加開発を見極めます。</p><p class="learning-source">連携設計の補足：<a href="https://docs.stripe.com/webhooks#handle-duplicate-events">Stripe：決済通知の重複と順序</a></p><p class="learning-note"><time datetime="2026-11-09">2026年11月9日 更新</time></p></section>
</article>
<script>import '../scripts/website-demo';</script>
