---
// 変更履歴: 2026-11-08 全ページで同じロゴ・名称を使い、ページ遷移時の別サイト感を防ぐため抽出。
// 役割: ヘッダーとフッターのブランド表示を一元化する。
interface Props { footer?: boolean; }
const { footer = false } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<a class:list={['brand', { 'brand--footer': footer }]} href={home} aria-label="ウェブのとなり ホームへ">
  <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M5 27C11 27 11 13 20 13s9 14 15 14" /><circle cx="5" cy="27" r="2.5" /><circle cx="35" cy="27" r="2.5" /></svg>
  <span translate="no">ウェブのとなり</span>
</a>
