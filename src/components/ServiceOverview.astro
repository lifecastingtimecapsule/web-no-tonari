---
// 変更履歴: 2026-11-11 横送り・重複ボタンをなくし、サービスごとに一つのリンクへ整理。
// 役割: 3サービスをその場で比較できる一覧。スマホでも隠れた項目を作らない。
import {servicePages} from '../data/services';
const serviceBase=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<div class="service-overview">
  {servicePages.map(service=><a class="service-overview__item" href={`${serviceBase}/services/${service.slug}/`}>
    <img src={`${serviceBase}/images/services/${service.slug}.${service.slug==='websites'?'webp':'png'}`} alt="" width="900" height="680" loading="lazy" />
    <h3>{service.name}<span aria-hidden="true">↗</span></h3>
    <p>{service.preview}</p><p class="service-overview__price">{service.priceShort}</p>
  </a>)}
</div>
<style>.service-overview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:40px}.service-overview__item{color:var(--ink);text-decoration:none}.service-overview img{width:100%;aspect-ratio:4/3;object-fit:cover}.service-overview h3{display:flex;justify-content:space-between;gap:12px;font-size:22px;margin:20px 0 14px}.service-overview p{font-size:14px;line-height:1.9}.service-overview__price{font-weight:700}.service-overview__item:focus-visible{outline:3px solid var(--signal);outline-offset:8px}@media(max-width:800px){.service-overview{grid-template-columns:1fr;gap:48px}.service-overview img{max-height:320px}}</style>
