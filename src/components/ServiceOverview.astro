---
// 変更履歴: 2026-11-11 横送り・重複ボタンをなくし、サービスごとに一つのリンクへ整理。
// 変更履歴: 2026-11-11 高さ680pxの固定を解除し、同じ比率の枠で画像全体を表示。
// 変更履歴: 2026-11-11 SEOカードを追加し、PCは2列で4サービスをそろえる。
// 役割: 4サービスをその場で比較できる一覧。スマホでも隠れた項目を作らない。
import {servicePages} from '../data/services';
interface Props { headingTag?: 'h2'|'h3'; }
const {headingTag:CardHeading='h3'}=Astro.props;
const serviceBase=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<div class="service-overview">
  {servicePages.map(service=><a class="service-overview__item" href={`${serviceBase}/services/${service.slug}/`}>
    <div class="service-overview__media"><img src={`${serviceBase}/images/services/${service.slug}.${service.slug==='websites'?'webp':service.slug==='seo'?'svg':'png'}`} alt="" width="900" height="680" loading="lazy" /></div>
    <CardHeading>{service.name}<span aria-hidden="true">↗</span></CardHeading>
    <p>{service.preview}</p><p class="service-overview__price">{service.priceShort}</p>
  </a>)}
</div>
<style>.service-overview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px;margin-top:40px}.service-overview__item{display:block;min-width:0;color:var(--ink);text-decoration:none}.service-overview__media{aspect-ratio:4/3;overflow:hidden;background:#edf5f7;display:grid;place-items:center}.service-overview img{display:block;width:100%;height:100%;min-height:0;object-fit:contain}.service-overview :is(h2,h3){display:flex;justify-content:space-between;gap:12px;font-size:22px;margin:20px 0 14px}.service-overview p{font-size:14px;line-height:1.9}.service-overview__price{font-weight:700}.service-overview__item:focus-visible{outline:3px solid var(--signal);outline-offset:8px}@media(max-width:800px){.service-overview{grid-template-columns:1fr;gap:48px}.service-overview__media{max-width:600px;width:100%}}</style>
