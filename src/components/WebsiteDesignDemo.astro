---
// 変更履歴: 2026-11-09 視線誘導・余白・文字組みを実際のページ上で確かめる教材として花屋サンプルを再構成。
// 役割: 架空の店舗ページと、その配置理由・現在の一次資料に基づく設計の基本を一緒に示す。
// 変更履歴: 2026-11-09 スマホでは選択箇所の直下に解説と次のポイントへの操作を表示し、画面外の説明との往復を減らす。
import '../styles/website-demo.css';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const principles = [
  ['情報の優先順位', '大きな見出しで「何のお店か」を伝え、写真でイメージを補い、条件を読んでから行動へ。全員の目が同じ順に動くわけではありません。'],
  ['見出しと読み飛ばし', '見出しだけでも内容が分かる言葉を使います。F型・Z型を当てはめることより、必要な情報を拾いやすいまとまりをつくります。'],
  ['文字サイズと行間', 'この見本の通常表示は本文16px・行間1.75。見出しは画面幅に応じて32〜48pxです。本文と見出しの差をつけ、長文は日本語で1行40字程度までを目安にします。'],
  ['余白と近接', '見出し・説明・条件をグループ化し、関係する情報は近く、別のまとまりは離します。見本では8・16・24・48pxを基準にし、画面が狭いときは調整します。'],
  ['色とコントラスト', '写真に文字を重ねず、白地に濃い文字を置きます。通常の文字は4.5:1以上を基準にし、重要度を色だけで区別しないようにします。'],
  ['行動ボタン', '「詳しく」だけでなく、次にすることが分かる名前を使います。主な行動を一つに絞り、ここでは高さ48px以上のボタンにしています。'],
  ['スマホと拡大表示', '狭い画面では1列に並べ替えます。文字は画像にせず、拡大や行間・文字間隔の変更をしても、読める・押せる状態を保ちます。'],
  ['実際の利用者で確かめる', '配置しただけで成果は決まりません。公開後は、目的の情報が見つかるか、ボタンの意味が伝わるかを実際の利用者と確認します。'],
];
---
<div class="website-demo" data-website-demo>
  <div class="website-demo__tools" aria-label="デザインの体験操作">
    <p>まずは、ひと目で何が伝わるか眺めてみてください。</p>
    <div>
      <button type="button" data-guide-toggle aria-pressed="false" aria-controls="design-guide-panel" disabled>解説を見る</button>
      <button type="button" data-spacing-toggle aria-pressed="false" disabled>余白を見る</button>
      <button type="button" data-type-toggle aria-pressed="false" disabled>文字を大きくする</button>
    </div>
  </div>

  <div class="flower-site" aria-label="架空の花屋のウェブサイト見本">
    <div class="flower-site__brand"><strong>花と、暮らし。</strong><span>架空の花屋のサイト見本</span></div>
    <div class="flower-site__hero">
      <div class="flower-site__headline" data-guide-zone="1">
        <button class="design-marker" type="button" data-guide-step="1" aria-label="1 見出しの解説" aria-pressed="false" aria-controls="design-guide-panel">1</button>
        <h3>いつもの部屋に、<br />ひと束の季節を。</h3>
        <p>花のある日を、もっと気軽に。<br />季節の花を束ねて、お待ちしています。</p>
        <aside class="design-zone-note" aria-label="見出しの解説"><p><strong>まず、ここに目がいきませんでしたか？</strong>見出しを大きくして、何のお店かを先に伝えます。</p><button type="button" data-guide-go="2">次は写真へ</button></aside>
      </div>
      <figure class="flower-site__photo" data-guide-zone="2">
        <button class="design-marker" type="button" data-guide-step="2" aria-label="2 写真の解説" aria-pressed="false" aria-controls="design-guide-panel">2</button>
        <img src={`${home}images/demos/florist-bouquet.webp`} alt="赤やピンクの花と緑の葉を束ねた、色鮮やかな季節の花束" width="1200" height="900" loading="lazy" decoding="async" />
        <div class="design-zone-note" role="note" aria-label="写真の解説"><p><strong>写真は、言葉を具体的にするもの。</strong>花の色や質感を伝え、文字を重ねず読みやすさを保ちます。</p><button type="button" data-guide-go="3">次は価格と条件へ</button></div>
        <figcaption>季節の花束のイメージ。販売商品ではありません。</figcaption>
      </figure>
      <div class="flower-site__details" data-guide-zone="3">
        <button class="design-marker" type="button" data-guide-step="3" aria-label="3 価格と受け取り条件の解説" aria-pressed="false" aria-controls="design-guide-panel">3</button>
        <p class="flower-site__price">季節の花束 <strong>¥3,300</strong><span>税込・サンプル価格</span></p>
        <p>店頭受け取り・3日前までのご予約。<br />花の種類や色合いは、季節に合わせてお選びします。</p>
        <aside class="design-zone-note" aria-label="価格と条件の解説"><p><strong>関係する情報は、近くに。</strong>価格・受け取り・予約期限をまとめると、判断のために探し回らずに済みます。</p><button type="button" data-guide-go="4">次は予約ボタンへ</button></aside>
      </div>
      <div class="flower-site__action" data-guide-zone="4">
        <button class="design-marker" type="button" data-guide-step="4" aria-label="4 行動ボタンの解説" aria-pressed="false" aria-controls="design-guide-panel">4</button>
        <button type="button" class="flower-site__reserve" data-flower-reserve>花束の受け取りを予約する</button>
        <p>操作見本です。予約・購入は行われません。</p>
        <aside class="design-zone-note" aria-label="行動ボタンの解説"><p><strong>何が起こるか、ボタンの言葉で伝える。</strong>条件を読んでから、次の行動を選べる位置にしています。</p><button type="button" data-guide-go="1">最初の見出しへ</button></aside>
      </div>
    </div>
  </div>

  <section class="design-guide" id="design-guide-panel" aria-labelledby="design-guide-title" hidden>
    <div class="design-guide__copy" role="status" aria-live="polite" aria-atomic="true">
      <p data-guide-progress>1 / 4</p>
      <h4 id="design-guide-title" data-guide-title>まず、ここに目がいきませんでしたか？</h4>
      <p data-guide-body>大きな見出しで、何のお店か・どんな気分になれるかを先に伝えています。目を引く強さに差をつけるのが、情報の優先順位です。</p>
      <p class="design-guide__value" data-guide-value>通常表示：見出し32〜48px ／ 本文16px</p>
    </div>
    <div class="design-guide__navigation"><button type="button" data-guide-prev disabled>前へ</button><button type="button" data-guide-next>次のポイントへ</button></div>
  </section>
  <p class="website-demo__feedback" role="status" aria-live="polite" data-website-feedback>番号は設計した情報の順番です。視線の計測・記録は行いません。</p>

  <details class="design-basics">
    <summary>このサンプルに入れた、デザインの基本を読む</summary>
    <dl>{principles.map(([title, body]) => <div><dt>{title}</dt><dd>{body}</dd></div>)}</dl>
    <p>数値は、この見本で選んだ設計値です。すべての業種や利用者に共通する正解ではありません。WCAGは単一の本文サイズや余白を指定する規格ではなく、読みやすさや操作性を損なわないための基準です。</p>
  </details>
  <div class="design-references">
    <h4>参考にした公開ガイド</h4>
    <p><time datetime="2026-11-09">2026年11月9日 確認</time>。新しい指針と、基礎となる視線研究を区別して参照しています。</p>
    <ul>
      <li><a href="https://design.digital.go.jp/dads/foundations/typography/" target="_blank" rel="noopener noreferrer">デジタル庁：文字サイズ・行間（2026年8月更新／別タブ）</a></li>
      <li><a href="https://design.digital.go.jp/dads/foundations/typography/accessibility/" target="_blank" rel="noopener noreferrer">デジタル庁：文字の拡大・行の長さ（別タブ）</a></li>
      <li><a href="https://www.nngroup.com/articles/text-scanning-patterns-eyetracking/" target="_blank" rel="noopener noreferrer">NN/g：読み飛ばし方の視線研究（2019年／別タブ）</a></li>
      <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html" target="_blank" rel="noopener noreferrer">W3C：文字のコントラスト（別タブ）</a></li>
      <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/text-spacing.html" target="_blank" rel="noopener noreferrer">W3C：文字間隔を変えても情報を失わないこと（別タブ）</a></li>
      <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html" target="_blank" rel="noopener noreferrer">W3C：操作対象の最小サイズと例外（別タブ）</a></li>
    </ul>
    <p class="design-references__photo">写真：<a href="https://unsplash.com/photos/a-vibrant-bouquet-of-assorted-colorful-flowers-QH5-_8Dcbq8" target="_blank" rel="noopener noreferrer">Evelien Van Den Brink / Unsplash（別タブ）</a>。架空の店舗・商品を説明するためのイメージです。</p>
  </div>
</div>
<script>import '../scripts/website-demo';</script>
