---
// 変更履歴: 2026-11-09 ホームと専用ページで同じ税込料金を表示するため追加。
// 変更履歴: 2026-11-09 漏えいチェックを含む四料金と受付準備状況を表示。
// 変更履歴: 2026-11-11 各料金を一つのリンクにまとめ、重複する説明ボタンを撤去。
// 変更履歴: 2026-11-11 漏えい履歴はオンライン無料と任意の郵送料金を分けて表示。
// 変更履歴: 2026-11-11 無料の照会カードは直接入力画面へ案内。
// 変更履歴: 2026-11-11 業務システムの顧客管理例を初期費用・月額の2つで表示。
// 役割: 基本料金とそれぞれの対象範囲へのリンクを表示する。
import {businessPricing} from '../data/business-pricing';
import { pricingPlans, formatPrice } from '../data/pricing';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<div class="pricing__primary" aria-label="基本料金・すべて税込">
  {pricingPlans.map(plan => <article class="pricing__primary-item"><a class="pricing-summary__item" href={plan.id === 'email-breach-check' ? `${home}email-check/` : `${home}pricing/#${plan.id}`}><p>{plan.name}</p>{'status' in plan && <p class="pricing-plan-status">{plan.status}</p>}<strong>{plan.id === 'email-breach-check' ? '無料' : formatPrice(plan.amount)}{plan.monthly && <small> / 月</small>}</strong><span>{plan.summary}</span>{plan.id === 'email-breach-check' && <span>郵送報告書 {formatPrice(plan.amount)}（税込・国内送料込み）</span>}<span class="pricing-summary__arrow" aria-hidden="true">↗</span></a></article>)}
  <article class="pricing__primary-item"><a class="pricing-summary__item" href={`${home}pricing/#business-pricing`}><p>業務システム開発・顧客管理の例</p><strong>{formatPrice(businessPricing[0].initial)}〜</strong><span>制作費・税込</span><span>月々 {formatPrice(businessPricing[0].monthly)}〜（当社で運用する場合）</span><span>顧客の登録・検索・対応履歴。ほかの仕事別の料金も掲載しています。</span><span class="pricing-summary__arrow" aria-hidden="true">↗</span></a></article>
</div>
<style>.pricing-summary__item{display:flex;flex-direction:column;gap:14px;color:inherit;text-decoration:none;min-height:100%;position:relative}.pricing-summary__item p{margin:0}.pricing-summary__item>span{font-size:14px;line-height:1.8}.pricing-summary__arrow{align-self:end}.pricing-summary__item:focus-visible{outline:3px solid #4489a5;outline-offset:8px}</style>
