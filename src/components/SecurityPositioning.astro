---
/* 変更履歴 2026-11-20　依頼者が困りごとと料金を同時に読めるように、単発・定期の長い説明を統合。 */
import { pricingPlans, emergencyMaintenancePlans, securityInvestigationPlans, formatPrice } from '../data/pricing';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const basic = pricingPlans.find(plan => plan.id === 'security')!;
const maintenance = pricingPlans.find(plan => plan.id === 'maintenance')!;
const update = emergencyMaintenancePlans[0];
const [review, penetration] = securityInvestigationPlans;
const choices = [
  { title: '会社のサイトを点検したい', copy: '以前の担当者が管理者のままになっていないか。データの控えはあるか。設定を確認し、先に直すところをお伝えします。',
    options: [{ plan: basic, suffix: '／回' }] },
  { title: '予約や会員情報を守りたい', copy: 'ログインした人に、別のお客様の情報が見えてしまわないか。画面の裏側のプログラムや設定を調べます。',
    options: [{ plan: review, suffix: '〜' }, { plan: penetration, suffix: '〜' }] },
  { title: 'サイトの管理を任せたい', copy: '日々のバックアップと更新状況の点検を承ります。古いWordPressの更新は、一度だけでもご相談いただけます。',
    options: [{ plan: maintenance, suffix: '／月' }, { plan: update, suffix: '〜' }] },
];
---
<section class="reader-section" id="services" aria-labelledby="positioning-title">
  <div class="reader-wrap" id="positioning">
    <header class="reader-heading">
      <h2 id="positioning-title">どんなことで<br />お困りですか。</h2>
      <p>ご依頼の内容と料金<span>（税込）</span></p>
    </header>
    <div class="reader-choices" id="service-modes">
      {choices.map(choice => <article class="reader-choice">
        <h3>{choice.title}</h3><p>{choice.copy}</p>
        <ul>{choice.options.map(({plan, suffix}) => <li>
          <a href={home + 'pricing/#' + plan.id}><span>{plan.name}</span><strong>{formatPrice(plan.amount)}{suffix}</strong></a>
        </li>)}</ul>
      </article>)}
    </div>
    <p class="reader-free">メールアドレスが漏えい記録にあるか知りたい方は、<a href={home + 'email-check/'}>無料のメールチェックへ</a></p>
  </div>
</section>
