---
// 変更履歴: 2026-11-09 購入者向け商品サンプルを、受注後の管理画面へ置換。
// 役割: 決済・出荷・返品の異なる状態と次の仕事を、架空注文で説明する。
import '../styles/service-operations.css';
const orderScenarios = [
  { id: 'payment', number: '#1042', label: '入金待ち', payment: '未入金', shipping: '未出荷', returns: 'なし', amount: '¥5,400', item: '朝のマグ × 2点', detail: '商品 ¥4,800 ＋ 送料 ¥600（税込）', owner: '受注担当', next: '入金明細との照合', note: 'この店舗は銀行振込・入金後発送。注文が入っただけでは、出荷へ進めません。代引き・後払いは別のルールで管理します。', steps: ['注文受付・在庫2点を確保', '入金待ち：振込名義と金額を照合', '入金確認後に出荷担当へ引き渡し'], explanation: '決済状態と出荷状態を別々に持つことで、「受注済み」を「入金済み」と読み違えにくくします。入金期限と担当者も置き、期限超過時の連絡・取消・在庫解放まで決めておきます。' },
  { id: 'shipping', number: '#1041', label: '一部発送', payment: '支払済み', shipping: '1 / 2点 出荷済み', returns: 'なし', amount: '¥5,400', item: '朝のマグ × 2点', detail: '砂色1点は出荷済み／赤土1点は取り寄せ中', owner: '出荷担当', next: '残り1点の入荷予定を連絡', note: '1点を送っても注文全体を完了にしません。商品ごとの残数、追跡番号、追加送料の扱いを確認します。', steps: ['支払確認・2点の注文を受付', '砂色1点を出荷・追跡情報を登録', '赤土1点が未出荷：予定日を連絡'], explanation: '出荷は注文単位だけでなく明細・数量単位でも管理します。「発送済み通知を送ったか」と「配送業者へ渡したか」も別の記録。分割出荷の可否や費用は、あらかじめお客様と合意した条件に従います。' },
  { id: 'return', number: '#1038', label: '返品対応', payment: '支払済み・返金未処理', shipping: '2 / 2点 配達済み', returns: '1点 返送品の検品待ち', amount: '¥5,400', item: '朝のマグ × 2点のうち1点', detail: '返金対象・送料負担は販売条件に沿って確認', owner: '返品担当', next: '検品と返金額の確認', note: '返品受付、返金、在庫への戻しは別の処理です。返金したからといって、その商品が再び売れるとは限りません。', steps: ['返品依頼を受付・対象明細を記録', '返送品を受領：数量と状態を検品', '条件に沿って返金・再販売可否を別々に記録'], explanation: '返金前に対象商品、数量、値引き、送料、すでに返した金額を照合します。再入庫は商品の状態を見て判断。誰がいつ処理したかを残し、二重返金と売れない商品の在庫戻しを防ぎます。' },
];
---
<section class="operations-demo" aria-labelledby="operations-title" data-order-demo>
  <header class="operations-demo__bar"><h3 id="operations-title">日々の道具店 <span>受注管理</span></h3><span>架空の管理画面</span></header>
  <p class="operations-demo__instruction">注文を選ぶと、状態と「次にする仕事」が切り替わります。実際の決済・発送・返金は行いません。</p>
  <div class="operations-demo__workspace">
    <div class="operations-demo__orders" role="group" aria-label="注文の場面を選ぶ" data-order-picker hidden>
      {orderScenarios.map((order, index) => <button type="button" data-order-select={order.id} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`order-${order.id}`}><span>{order.number}</span><strong>{order.label}</strong><small>{order.next}</small></button>)}
    </div>
    <div class="operations-demo__detail">
      {orderScenarios.map(order => <section id={`order-${order.id}`} data-order-panel={order.id} aria-labelledby={`order-heading-${order.id}`}>
        <div class="operations-demo__title"><h4 id={`order-heading-${order.id}`}>注文 {order.number}</h4><p>{order.amount}<small>税込・サンプル</small></p></div>
        <dl class="operations-demo__statuses"><div><dt>決済</dt><dd>{order.payment}</dd></div><div><dt>出荷</dt><dd>{order.shipping}</dd></div><div><dt>返品</dt><dd>{order.returns}</dd></div></dl>
        <div class="operations-demo__item"><strong>{order.item}</strong><p>{order.detail}</p></div>
        <div class="operations-demo__next"><span>{order.owner}の次の対応</span><h5>{order.next}</h5><p>{order.note}</p></div>
        <ol class="operations-demo__history" aria-label="対応の流れ">{order.steps.map(step => <li>{step}</li>)}</ol>
        <details><summary>この管理画面で、弊社が分けて考えること</summary><p>{order.explanation}</p></details>
      </section>)}
    </div>
  </div>
  <p class="operations-demo__status" role="status" aria-live="polite" aria-atomic="true" data-order-feedback></p>
  <p class="operations-demo__footnote">既存のECサービスを活用する場合も、担当者・確認条件・例外時の動きを整理します。表示は独自の設計例で、特定サービスの実画面ではありません。</p>
</section>
<script>
  // 役割: 注文の教材を切り替えるだけで、取引データや外部サービスは更新しない。
  const orderDemo = document.querySelector<HTMLElement>('[data-order-demo]');
  if (orderDemo) {
    const orderButtons = orderDemo.querySelectorAll<HTMLButtonElement>('[data-order-select]');
    const orderPanels = orderDemo.querySelectorAll<HTMLElement>('[data-order-panel]');
    const orderFeedback = orderDemo.querySelector<HTMLElement>('[data-order-feedback]');
    const orderPicker = orderDemo.querySelector<HTMLElement>('[data-order-picker]');
    if (orderPicker) orderPicker.hidden = false;
    orderPanels.forEach((panel, index) => { panel.hidden = index !== 0; });
    orderButtons.forEach(button => button.addEventListener('click', () => {
      orderButtons.forEach(choice => choice.setAttribute('aria-pressed', String(choice === button)));
      orderPanels.forEach(panel => { panel.hidden = panel.dataset.orderPanel !== button.dataset.orderSelect; });
      if (orderFeedback) orderFeedback.textContent = `${button.querySelector('strong')?.textContent}の注文を表示しました。決済・出荷・返品の状態と、次の対応を確認できます。`;
    }));
  }
</script>
