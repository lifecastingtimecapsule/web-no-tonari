---
// 変更履歴: 2026-11-09 サービス専用ページを作るため、既存の横送り一覧を共通化。
// 役割: 同じ三サービス・紹介画像・詳細への入口をホームと一覧へ表示する。
import { servicePages } from '../data/services';
interface Props { headingTag?: 'h2' | 'h3'; }
const { headingTag: CardHeading = 'h3' } = Astro.props;
const serviceBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---
          <div class="service-carousel-controls" data-service-controls hidden>
            <p aria-live="polite" aria-atomic="true" data-service-position>1〜3 / {servicePages.length}</p>
            <div>
              <button type="button" aria-label="前のサービスを表示" aria-controls="service-carousel" data-service-prev disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
              <button type="button" aria-label="次のサービスを表示" aria-controls="service-carousel" data-service-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
            </div>
          </div>
          <div class="service-list" id="service-carousel" data-service-list tabindex="0" role="region" aria-label="サービス一覧。横にスクロールして閲覧できます">
            {servicePages.map(service => (
              <article class="service-row" aria-labelledby={`service-${service.slug}`}>
                <a class="service-row__preview" href={`${serviceBase}/services/${service.slug}/#sample`} aria-label={service.slug === 'websites' ? '体験で、デザインの考え方を知る' : `${service.name}の体験サンプルを触る`}>
                  <img src={`${serviceBase}/images/services/${service.slug}.${service.slug === 'websites' ? 'webp' : 'png'}`} alt={service.slug === 'websites' ? '文字サイズと余白・配色・レスポンシブの配置を学ぶ記事' : `${service.name}の体験サンプル画面`} width={service.slug === 'websites' ? 1000 : 900} height={service.slug === 'websites' ? 644 : 680} loading="lazy" decoding="async" />
                  <span>{service.slug === 'websites' ? '見て、触って学ぶ' : '体験サンプル'}</span>
                </a>
                <CardHeading id={`service-${service.slug}`}><a href={`${serviceBase}/services/${service.slug}/`}>{service.name}</a></CardHeading>
                <p class="service-row__summary">{service.preview}</p>
                <p class="service-row__price">{service.priceShort}</p>
                <a class="text-link service-row__detail" href={`${serviceBase}/services/${service.slug}/`}>サンプルと詳しい内容を見る</a>
              </article>
            ))}
          </div>

<script>import '../scripts/service-carousel';</script>
