---
// 変更履歴: 2026-11-11 安全チェック横にあった端末ビジュアルを復元し、入力と横並びにする。
// 役割: URL入力と以前の画面イメージを一つにまとめ、スマホでも画像を消さず表示する。
---
<section class="safety-entry shell" id="after-hero" aria-labelledby="safety-entry-title">
 <div class="safety-entry__copy">
  <h2 id="safety-entry-title">いまのサイトを、<br />確かめる。</h2>
  <form data-safety-check-form novalidate>
   <label for="safety-check-url" class="safety-entry__label">サイトのURL</label>
   <div class="safety-entry__input"><input id="safety-check-url" name="safetyCheckUrl" type="url" inputmode="url" autocomplete="url" spellcheck="false" placeholder="example.com" aria-describedby="safety-check-note safety-check-status" required /><button type="submit">安全チェック <span aria-hidden="true">↗</span></button></div>
   <p id="safety-check-note">無料・登録不要</p><p id="safety-check-status" role="status" data-safety-check-status></p>
  </form>
 </div>
  <div class="check-visual" aria-hidden="true">
    <div class="check-browser-card" aria-hidden="true" data-hero-browser>
      <div class="check-browser-bar"><span></span><span></span><span></span><p>サイト確認のイメージ</p></div>
      <div class="check-browser-content">
        <p class="check-browser-kicker">SAFETY CHECK</p>
        <h2>いまのウェブを、<br />先に確かめる。</h2>
        <div class="check-preview-url"><span data-check-preview-url>yourbusiness.com</span><i data-check-preview-state>入力待ち</i></div>
        <div class="check-browser-choice"><span>通信の暗号化</span><i></i></div>
        <div class="check-browser-choice"><span>ブラウザ向けの保護設定</span><i></i></div>
        <div class="check-browser-choice"><span>なりすましメール対策</span><i></i></div>
      </div>
    </div>
    <div class="check-mobile-card" aria-hidden="true" data-hero-mobile>
      <p>WORKSPACE</p>
      <div class="check-mobile-rule"></div>
      <strong>今日、<br />整えること。</strong>
      <ul><li>サイトの更新</li><li>問い合わせ確認</li><li>情報の扱い</li></ul>
    </div>
    <div class="check-health-card" aria-hidden="true" data-hero-health><span class="check-health-dot"></span><span>URLから、最初の確認を。</span></div>
  </div>
</section>
<style>
.safety-entry{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:center;padding-top:120px;padding-bottom:80px;scroll-margin-top:calc(-1 * (var(--header-height) + 24px))}
.safety-entry__copy{min-width:0}.safety-entry h2{font-size:clamp(30px,3.6vw,54px);line-height:1.3;letter-spacing:-.04em;margin:0 0 32px}.safety-entry__label{display:block;font-size:13px;margin-bottom:10px}.safety-entry__input{display:flex;gap:8px;padding:8px;background:#edf5f7}.safety-entry input{width:0;min-width:0;flex:1;border:0;background:transparent;padding:12px;font:inherit;font-size:16px;color:var(--ink)}.safety-entry button{border:0;padding:14px 20px;background:var(--ink);color:white;font:inherit;font-size:13px;font-weight:700;white-space:nowrap;cursor:pointer}.safety-entry button span{margin-left:16px}.safety-entry form p{font-size:12px;line-height:1.8;color:var(--ink-muted);margin:12px 0 0}#safety-check-status{min-height:1.8em}.safety-entry :is(input,button):focus-visible{outline:3px solid #4489a5;outline-offset:4px}
  .check-visual { position: relative; min-width: 0; height: 460px; }
  .check-visual::before { content: ''; position: absolute; inset: 38px 20px 36px 40px; background: #cce9ec; border-radius: 48% 48% 28% 48%; transform: rotate(-8deg); }
  .check-browser-card { position: absolute; z-index: 1; top: 17px; right: 4%; width: 82%; overflow: hidden; border: 1px solid #d5d5db; border-radius: 14px; background: #f7f7f8; box-shadow: 0 22px 48px rgb(20 20 22 / 13%); transform: rotate(3deg); }
  .check-browser-bar { display: flex; height: 31px; align-items: center; gap: 5px; padding: 0 12px; border-bottom: 1px solid #dfdfe4; background: #fff; }
  .check-browser-bar > span { width: 6px; height: 6px; border-radius: 50%; background: #c6c6cd; }
  .check-browser-bar p { margin: 0 auto; padding-right: 30px; color: #8d8d94; font-size: 9px; }
  .check-browser-content { padding: 33px 38px 35px; background: #fff; }
  .check-browser-kicker { margin: 0 0 11px; color: var(--signal); font-size: 10px; font-weight: 700; letter-spacing: .08em; }
  .check-browser-content h2 { margin: 0 0 23px; font-size: clamp(1.35rem, 2.1vw, 2.05rem); font-weight: 900; line-height: 1.18; letter-spacing: -.05em; }
  .check-preview-url { display: flex; min-height: 37px; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; padding: 0 11px; border-radius: 8px; background: #1b1b1f; color: white; font-size: 10px; }
  .check-preview-url span { max-width: 67%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .check-preview-url i { color: #f3a5ae; font-size: 8px; font-style: normal; font-weight: 700; }
  .check-browser-choice { display: flex; align-items: center; justify-content: space-between; min-height: 40px; padding: 0 13px; border-top: 1px solid #dedee3; color: #37373d; font-size: 11px; }
  .check-browser-choice:last-child { border-bottom: 1px solid #dedee3; }
  .check-browser-choice i { width: 8px; height: 8px; border-radius: 50%; background: var(--signal); }
  .check-mobile-card { position: absolute; z-index: 2; right: 2%; bottom: 12px; width: 34%; min-width: 154px; padding: 22px 18px 19px; border: 5px solid #17171b; border-radius: 25px; background: #18181c; color: white; box-shadow: 0 18px 36px rgb(20 20 22 / 23%); transform: rotate(6deg); }
  .check-mobile-card > p { margin: 0 0 16px; color: #aaaab0; font-size: 8px; font-weight: 700; letter-spacing: .13em; }
  .check-mobile-rule { width: 100%; height: 7px; margin-bottom: 17px; border-radius: 99px; background: #303036; }
  .check-mobile-card strong { display: block; font-size: clamp(1rem, 1.5vw, 1.28rem); line-height: 1.35; letter-spacing: -.04em; }
  .check-mobile-card ul { margin: 17px 0 0; padding: 0; list-style: none; color: #d1d1d4; font-size: 9px; line-height: 2; }
  .check-mobile-card li::before { content: '•'; margin-right: 7px; color: var(--signal); }
  .check-health-card { position: absolute; z-index: 3; top: 0; right: -3%; display: inline-flex; min-height: 43px; align-items: center; gap: 8px; padding: 0 16px; border: 1px solid #dddde2; border-radius: 12px; background: white; box-shadow: 0 10px 28px rgb(20 20 22 / 10%); font-size: 11px; font-weight: 700; transform: rotate(2deg); }
  .check-health-dot { width: 9px; height: 9px; border-radius: 50%; background: #19b969; }

@media(max-width:1100px) and (min-width:801px){.safety-entry{gap:32px}.check-visual{height:400px}.check-browser-content{padding:26px}.check-browser-content h2{font-size:24px}.check-health-card{font-size:10px;right:0}}
@media(max-width:800px){.safety-entry{grid-template-columns:1fr;gap:36px;padding-top:110px;padding-bottom:64px}.safety-entry h2{font-size:32px;margin-bottom:24px}.check-visual{width:min(520px,100%);height:410px;justify-self:center}.check-browser-content{padding:28px}.check-browser-content h2{font-size:26px}.check-health-card{right:0}}
@media(max-width:480px){.check-visual{height:330px}.check-browser-card{width:84%;top:16px}.check-browser-content{padding:22px}.check-browser-content h2{font-size:22px;margin-bottom:18px}.check-browser-choice{min-height:30px;font-size:9px;padding-inline:4px}.check-mobile-card{min-width:116px;width:37%;padding:16px 12px;bottom:4px;border-radius:20px}.check-mobile-card strong{font-size:17px}.check-mobile-card>p{font-size:7px;margin-bottom:12px}.check-mobile-card ul{font-size:8px;margin-top:10px}.check-health-card{min-height:34px;font-size:8px;padding-inline:10px}.safety-entry__input{padding:6px}.safety-entry button{padding-inline:14px}.safety-entry button span{margin-left:8px}}
</style>
