---
// 変更履歴: 2026-11-13 他社制作・対応を断られた案件の相談と、更新・緊急初動の料金を同じ場所に表示。
// 役割: 何を依頼でき、いくらからで、どこまで含むかを短く示す。
import {emergencyMaintenancePlans,formatPrice} from '../data/pricing';
const {showContact=true}=Astro.props;
const home=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<section class="urgent-plans" id="urgent-support" aria-labelledby="urgent-title"><h2 id="urgent-title">更新も、急ぎの困りごとも。</h2><p>PHPの更新、突然のエラー、引き継ぎ先が見つからないサイト。<strong>他社で対応を断られた案件も、ぜひ一度ご相談ください。</strong>現在の状態を確認し、対応できる範囲をご案内します。</p><div class="urgent-grid">{emergencyMaintenancePlans.map(plan=><article id={plan.id}><h3>{plan.name}</h3><p class="urgent-price">{formatPrice(plan.amount)}〜<small>税込・{plan.unit}</small></p><p>{plan.summary}</p><ul>{plan.included.map(item=><li>{item}</li>)}</ul><p>{plan.scope}</p><p class="urgent-note">別料金・対象外：{plan.excluded}</p>{showContact&&<a class="text-link" href={`${home}?service=${encodeURIComponent(plan.name)}#contact`}>{plan.name}について相談する</a>}</article>)}</div><p class="urgent-note">相談は無料です。追加費用が必要な場合は先にお伝えします。他社制作という理由だけで一律の割増は行いません。</p></section>
<style>.urgent-plans{padding:32px 0;border-top:1px solid #e4e2de}.urgent-plans h2{font-size:clamp(24px,3vw,34px);margin:0 0 18px}.urgent-plans>p{max-width:850px;line-height:1.85}.urgent-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:24px 0}.urgent-grid article{padding:26px;border:1px solid #e9dfd6;border-radius:12px;background:linear-gradient(135deg,#fff1e4,#fff 65%)}.urgent-grid h3{font-size:22px;margin:0 0 18px}.urgent-price{font-size:30px;font-weight:700;line-height:1.4}.urgent-price small{display:block;font-size:13px;font-weight:400;margin-top:8px}.urgent-grid p,.urgent-grid li{line-height:1.85;overflow-wrap:anywhere}.urgent-grid ul{padding-left:20px}.urgent-note{font-size:13px;color:#68625e}.urgent-grid a{display:inline-block;margin-top:12px}@media(max-width:700px){.urgent-grid{grid-template-columns:1fr;gap:16px}.urgent-grid article{padding:22px}.urgent-price{font-size:28px}}</style>
