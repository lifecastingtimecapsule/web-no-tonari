---
// 変更履歴: 2026-11-11 送信ボタンを中央配置へ変更。スマホの全幅表示は維持。
// 変更履歴: 2026-11-11 他社の問い合わせ構成を参考に、会社・氏名・連絡先・内容の順へ整理。屋号を平易にし、PCはラベル横・スマホは縦に表示。
// 変更履歴: 2026-11-11 料金から問い合わせへ直接進み、選んだ内容と金額を引き継ぐ。
// 変更履歴: 2026-11-11 再レビューで業務システム開発へ案内を統一。専門語と寄り道を減らし、問い合わせへ直接つなぐ。
// 変更履歴: 2026-11-11 コピー・メーラー起動を撤去し、入力と一つの送信ボタンに整理。
// 役割: 問い合わせを自社窓口へ送り、失敗時には入力を残して再試行できるようにする。
---
<form class="contact-form" data-direct-contact novalidate>
  <p class="contact-form__intro">ご相談内容をお送りください。メールでご連絡します。</p>
  <div class="field"><label for="contact-company">会社名・お店の名前 <span class="optional">任意</span></label><input id="contact-company" name="company" autocomplete="organization" maxlength="200" /></div>
  <div class="field"><label for="contact-name">お名前 <span>必須</span></label><input id="contact-name" name="name" autocomplete="name" maxlength="100" required /></div>
  <div class="field"><label for="contact-email">メールアドレス <span>必須</span></label><input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" maxlength="254" required /></div>
  <div class="field"><label for="message">ご相談内容 <span>必須</span></label><textarea id="message" name="message" rows="5" maxlength="5000" placeholder="相談したいことや、ご希望をお書きください。" required></textarea></div>
  <div class="contact-trap" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
  <p class="contact-use">入力内容はお問い合わせへの返信に利用します。パスワードなどの秘密情報は記入しないでください。</p>
  <button class="button button--human" type="submit" data-contact-send>送信する</button>
  <p class="form-status" role="status" tabindex="-1" data-contact-result></p>
</form>
<script>import '../scripts/contact-form';</script>
<style>
/* 役割: 入力項目を罫線と一定の並びで読みやすくし、スマホでは一列で入力できるようにする。 */
.contact-form__intro{margin:0 0 20px;font-size:14px;line-height:1.75}
.contact-form .field{display:grid;grid-template-columns:190px minmax(0,1fr);align-items:start;gap:20px;padding:20px 0;border-top:1px solid var(--mist);margin:0}
.contact-form .field label{font-size:14px;line-height:1.7;padding-top:12px;margin:0}
.contact-form .field label span{display:inline-block;font-weight:400;font-size:12px;margin-left:6px}
.contact-form .field input,.contact-form .field textarea{border-radius:4px;font-size:16px}
.contact-form .field textarea{min-height:140px}
.contact-trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
.contact-use{font-size:12px;line-height:1.8;color:var(--ink-muted);margin:8px 0 0}
.form-status{min-height:0}.form-status:empty{display:none}
.contact-form [data-contact-send]{display:flex;width:220px;max-width:100%;border-radius:4px;min-height:48px;margin:20px auto 0}
@media(max-width:600px){.contact-form .field{grid-template-columns:minmax(0,1fr);gap:8px;padding:16px 0}.contact-form .field label{padding-top:0}.contact-form [data-contact-send]{width:100%}}
</style>
