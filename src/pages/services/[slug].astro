---
// 変更履歴: 2026-11-09 基本確認の対象外となる専門診断の参考費用へ入口を追加。
// 変更履歴: 2026-11-09 詳細からサービス一覧と料金ページへ戻れる導線を追加。
// 変更履歴: 2026-11-09 詳細を三サービスへ整理し、ウェブ教材の入口を三体験へ合わせる。
// 変更履歴: 2026-11-08 サービスごとの事業説明、操作サンプル、豆知識を独立ページとして追加。
// 変更履歴: 2026-11-09 安全確認ページは、体験後にサイト側の備えと相談へつなぐ文章へ変更。
// 変更履歴: 2026-11-11 説明を短くし、詳細を折りたたみに整理。送信済みフォームへ相談する導線を統一。
// 変更履歴: 2026-11-11 SEO詳細を追加。存在しない体験は表示せず、対応内容へ案内。
// 変更履歴: 2026-11-11 SEOは短い進め方を常時表示し、内部ノウハウの羅列を避ける。
// 変更履歴: 2026-11-11 参考資料・他社価格への公開リンクを削除し、サービスの検索タイトルを整理。
// 変更履歴: 2026-11-11 導入に価格と対象範囲を常時表示し、条件をその場で開けるよう変更。
// 役割: 共通のブランドとナビを保ち、4領域の提供内容を具体的に説明する。
// 変更履歴: 2026-11-08 トップと同じ共通レイアウト・ナビ・ロゴを適用。
// 変更履歴: 2026-11-09 ウェブ制作の体験を記事形式に変更し、タイトルと入口の操作名を内容に合わせた。
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/services.css';
import { servicePages } from '../../data/services';
import InlinePricing from '../../components/InlinePricing.astro';
import ServiceDemo from '../../components/ServiceDemo.astro';
export function getStaticPaths() { return servicePages.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
// 変更履歴: 2026-11-09 EC・安全確認の入口を記事に合わせ、重複する旧豆知識を省く。
// 変更履歴: 2026-11-09 ECの操作名を管理画面へ合わせる。
const searchTitles: Record<string,string> = {websites:'ホームページ制作・リニューアル',seo:'SEO対策・現状診断','ai-apps':'AIアプリ開発・業務効率化',security:'ホームページ保守・セキュリティ確認'};
const servicePlanIds:Record<string,string[]>={websites:['website'],seo:['seo'],security:['maintenance','security'],'ai-apps':[]};
const sampleAction = service.slug === 'security' ? 'フィッシングを見抜いてみる' : service.slug === 'websites' ? '体験で、考え方を知る' : 'サンプルを触ってみる';
---
<SiteLayout title={`${searchTitles[service.slug] ?? service.name}｜SITEVEIL`} description={service.description}>
<div class="shell"><nav class="page-breadcrumb" aria-label="パンくず"><a href={home}>ホーム</a><span aria-hidden="true">/</span><a href={`${home}services/`}>サービス</a><span aria-hidden="true">/</span><span aria-current="page">{service.name}</span></nav>
<section class="service-intro"><div><h1>{service.title.split('\n').map(line => <span>{line}</span>)}</h1><p>{service.slug === 'seo' ? service.lead : service.preview}</p>{service.slug === 'ai-apps' ? <p class="service-price-quote"><strong>個別見積もり</strong><br />画面・機能・連携先を整理し、着手前に費用を提示。AI利用料は別途ご案内します。</p> : <InlinePricing planIds={servicePlanIds[service.slug]||[]} />}<a class="button button--human" href={service.slug === 'seo' ? '#service-scope' : '#sample'}>{service.slug === 'seo' ? '対応内容を見る' : sampleAction}</a></div><aside id="service-scope"><h2>{service.slug === 'seo' ? '私たちの進め方' : `${service.name}でできること`}</h2>{service.tasks.map(([title, body]) => service.slug === 'seo' ? <article class="seo-method"><h3>{title}</h3><p>{body}</p></article> : <details class="service-task"><summary>{title}</summary><p>{body}</p></details>)}</aside></section>
{service.slug === 'security' && <section class="service-close"><h2>確認したいことから、選ぶ。</h2><p>サイトの状態、メールの漏洩、システムの詳しい検査。必要な範囲を整理できます。</p><a class="button button--human" href={`${home}security/`}>安全性の確認・調査を選ぶ</a></section>}
{service.slug !== 'seo' && <section class="service-sample" id="sample" aria-labelledby="sample-title"><div class="service-section-heading"><h2 id="sample-title">{service.sampleTitle}</h2><p>{service.sampleIntro}</p></div><ServiceDemo slug={service.slug} /></section>}
{service.slug !== 'security' && <details class="service-more"><summary>制作・活用のヒント</summary><section class="service-notes" aria-labelledby="notes-title"><div class="service-section-heading"><h2 id="notes-title">知っておくと、<br />頼みやすくなる。</h2><p>相談の前に読める、小さなコラム。<br /><time datetime={service.slug === 'seo' ? '2026-11-11' : service.slug === 'websites' ? '2026-11-09' : '2026-11-08'}>{service.slug === 'seo' ? '2026年11月11日' : service.slug === 'websites' ? '2026年11月9日' : '2026年11月8日'} 更新</time></p></div><div class="service-notes__articles">{service.tips.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div></section></details>}
<section class="service-close"><h2>{service.slug === 'security' ? 'サイトの備えも、一緒に確認しませんか。' : 'この先は、あなたの仕事に合わせて。'}</h2>{service.slug === 'security' && <><p>不審な連絡への注意に加え、サイト側の更新やバックアップも大切です。今の管理状況を確認し、必要な対策と費用を整理します。</p><p><a href={`${home}services/security/php/`}>更新を止めると何が起きる？ 古いPHPのリスクを読む</a></p></>}<p>{service.priceNote}</p><a class="button button--human" href={`${home}?service=${encodeURIComponent(service.name)}#contact`}>相談する</a></section>
</div><script>import '../../scripts/service-demos';</script>
</SiteLayout>

<style>
/* 役割: SEOの方針を三つの短い段落で示し、操作なしで読み進められるようにする。 */
/* 変更履歴: 2026-11-11 方針と内部手順を分け、細い区切り線で読み順を整理。 */
.seo-method{padding:20px 0;border-top:1px solid #e4e8e5}.seo-method h3{margin:0 0 10px;font-size:19px}.seo-method p{margin:0;font-size:14px;line-height:1.9;color:#465359}
</style>
