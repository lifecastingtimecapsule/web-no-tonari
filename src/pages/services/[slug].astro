---
/* 変更履歴 2026-11-20　複数ページで繰り返していた料金の詳細を集約し、依頼後の流れと報告を説明。 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import { servicePages } from '../../data/services';
import { pricingPlans, formatPrice } from '../../data/pricing';
import '../../styles/catalog.css';
/** 公開中のサービスに対応する案内ページを生成する。 */
export function getStaticPaths() {
  return servicePages.map(service => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const basic = pricingPlans.find(plan => plan.id === 'security')!;
---
<SiteLayout title={service.searchTitle} description={service.description} breadcrumbs={[{name:'ホーム',path:home},{name:'サービス',path:home+'services/'},{name:service.name,path:home+'services/'+service.slug+'/'}]}>
  <div class="shell catalog-page">
    <nav class="page-breadcrumb" aria-label="パンくず"><a href={home}>ホーム</a><span>/</span><a href={home + 'services/'}>サービス</a><span>/</span><span aria-current="page">検査の流れ</span></nav>
    <header class="catalog-heading"><h1>ご相談から報告まで</h1><p>基本セキュリティ確認は1回 {formatPrice(basic.amount)}（税込・国内送料込み）。<br />何を調べるか、最初に一緒に決めます。</p></header>
    <ol class="reader-steps">
      <li><h2>気になることをお聞きします</h2><p>「以前の担当者しか設定を知らない」「予約サイトにお客様の情報を預かっている」など、普段の言葉でお知らせください。必要な資料はこちらからご案内します。</p></li>
      <li><h2>範囲と費用を決めて調べます</h2><p>対象・方法・費用を書面で合意してから始めます。侵入テストを選ぶ場合は、本番から切り離した複製環境でのみ検証します。<a href={home + 'pricing/'}>検査別の料金と対象範囲</a></p></li>
      <li><h2>対応の順番を書面でお届けします</h2><p>基本確認・詳細検査・総合検査の結果は国内へ郵送します。先に直す項目と、追加で確認したい点が分かります。調査データの保管は発送後30日間です。</p></li>
    </ol>
    <p class="reader-more">継続して点検する場合は、<a href={home + 'service-specification/#monitoring-title'}>定期確認の範囲</a>をご覧ください。更新作業・修正・復旧は別途お見積もりします。</p>
    <section class="catalog-close"><h2>検査について相談する</h2><a class="button button--human" href={home + '?service=' + encodeURIComponent(service.name) + '#contact'}>お問い合わせフォームへ</a></section>
    <aside class="reader-more">関連する読み物　<a href={home + 'services/security/php/'}>古いPHPで何が起きる？</a>　<a href={home + 'services/security/examples/'}>不審な連絡の見分け方</a></aside>
  </div>
</SiteLayout>
