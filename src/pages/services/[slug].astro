---
// 変更履歴: 2026-11-08 サービスごとの事業説明、操作サンプル、豆知識を独立ページとして追加。
// 役割: 共通のブランドとナビを保ち、4領域の提供内容を具体的に説明する。
import '../../styles/global.css';
import '../../styles/services.css';
import { servicePages } from '../../data/services';
import ServiceDemo from '../../components/ServiceDemo.astro';
export function getStaticPaths() { return servicePages.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const canonical = `https://lifecastingtimecapsule.github.io${home}services/${service.slug}/`;
---
<!doctype html>
<html lang="ja"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{service.name}・体験サンプル｜ウェブのとなり</title><meta name="description" content={service.description} /><meta property="og:title" content={`${service.name}｜ウェブのとなり`} /><meta property="og:description" content={service.description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><link rel="canonical" href={canonical} /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap" rel="stylesheet" /></head>
<body class="service-page"><a class="skip-link" href="#main">本文へ移動</a>
<header class="service-header shell"><a class="brand" href={home}>ウェブのとなり</a><a href={`${home}#services`}>サービス一覧</a><a class="service-header__contact" href={`${home}#contact`}>相談内容をまとめる</a></header>
<main id="main"><div class="shell"><nav class="service-tabs" aria-label="サービス別ページ">{servicePages.map(item => <a href={`${home}services/${item.slug}/`} aria-current={service.slug === item.slug ? 'page' : undefined}>{item.name}</a>)}</nav>
<section class="service-intro"><div><h1>{service.title.split('\n').map(line => <span>{line}</span>)}</h1><p>{service.lead}</p><a class="button button--human" href="#sample">サンプルを触ってみる</a></div><aside><h2>{service.name}でできること</h2>{service.tasks.map(([title, body]) => <div class="service-task"><h3>{title}</h3><p>{body}</p></div>)}</aside></section>
<section class="service-sample" id="sample" aria-labelledby="sample-title"><div class="service-section-heading"><h2 id="sample-title">{service.sampleTitle}</h2><p>{service.sampleIntro}</p></div><ServiceDemo slug={service.slug} /></section>
<section class="service-notes" aria-labelledby="notes-title"><div class="service-section-heading"><h2 id="notes-title">知っておくと、<br />頼みやすくなる。</h2><p>相談の前に読める、小さなコラム。<br /><time datetime="2026-11-08">2026年11月8日 更新</time></p></div><div class="service-notes__articles">{service.tips.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div>{service.source && <p class="service-source">参考資料：<a href={service.source} target="_blank" rel="noopener noreferrer">{service.sourceLabel}（別タブ）</a></p>}</section>
<section class="service-close"><h2>この先は、あなたの仕事に合わせて。</h2><p class="service-close__price">{service.price}</p><p>{service.priceNote}</p><a class="button button--human" href={`${home}?service=${encodeURIComponent(service.name)}#contact`}>この内容で相談をまとめる</a><p class="service-close__notice">相談受付用のメールアドレスは準備中です。現在は入力内容の整理まで利用できます。</p></section>
</div></main><footer class="service-footer shell"><a href={home}>ウェブのとなり ホームへ</a><span>© 2026 ウェブのとなり</span></footer><script>import '../../scripts/service-demos';</script></body></html>
