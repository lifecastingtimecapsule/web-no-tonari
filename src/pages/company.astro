---
// 変更履歴: 2026-11-08 ユーザー提供の会社名・市区町村と国税庁で確認した法人番号に基づき会社概要を追加。
// 役割: サービスの運営主体を明示する。設立日・代表者は未確認のため掲載しない。
// 変更履歴: 2026-11-08 ユーザーが確認した資本金100万円を追加。
// 変更履歴: 2026-11-08 フッターと連続して重複する本文末尾のリンク列を撤去し、回遊導線を共通フッターへ集約。
import SiteLayout from '../layouts/SiteLayout.astro';
// 変更履歴: 2026-11-08 共通レイアウトを採用し、トップから移動した際のロゴ・ナビ・書体・フッターの断絶を解消。
import '../styles/services.css';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<SiteLayout title="会社概要｜SITEVEIL" description="SITEVEILの運営会社、株式会社ライフキャスティングジャパンの会社概要。愛知県大府市を拠点とするウェブ・ITサービスのご案内。">
<div class="company shell">
      <nav aria-label="パンくず"><a href={home}>ホーム</a><span aria-hidden="true">/</span><span aria-current="page">会社概要</span></nav>
      <h1>会社概要</h1>
      <p class="company__intro">「SITEVEIL」は、株式会社ライフキャスティングジャパンが運営するウェブ・ITサービスです。</p>
      <dl>
        <div><dt>運営会社</dt><dd>株式会社ライフキャスティングジャパン</dd></div>
        <div><dt>サービス名</dt><dd>SITEVEIL</dd></div>
        <div><dt>所在地</dt><dd>愛知県大府市</dd></div>
        <div><dt>資本金</dt><dd>100万円</dd></div>
        <div><dt>法人番号</dt><dd>3180001172553</dd></div>
        <div><dt>本サイトの事業内容</dt><dd><ul><li>ウェブサイトの企画・デザイン・制作</li><li>ECショップのデザイン・制作</li><li>AIアプリ開発・業務活用の支援</li><li>ウェブサイトの保守・更新・セキュリティ確認</li></ul></dd></div>
      </dl>
      <p class="company__source"><a href="https://www.houjin-bangou.nta.go.jp/henkorireki-johoto.html?selHouzinNo=3180001172553" target="_blank" rel="noopener noreferrer">国税庁法人番号公表サイトで法人情報を確認する（別タブ）</a></p>
    </div>
</SiteLayout>
<style>
  .company { max-width: 900px; padding-top: 0; padding-bottom: 0; }
  nav { display: flex; gap: 14px; margin-bottom: 36px; font-size: 13px; color: var(--ink-muted); }
  h1 { font-size: clamp(1.8rem, 3vw, 2.3rem); line-height: 1.5; margin-bottom: 24px; }
  .company__intro { font-size: 16px; line-height: 2; color: var(--ink-muted); margin-bottom: 36px; }
  dl { margin: 0; border-top: 1px solid var(--mist); }
  dl > div { display: grid; grid-template-columns: 190px 1fr; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--mist); font-size: 15px; line-height: 1.9; }
  dt { font-weight: 700; } dd { margin: 0; } ul { list-style: none; padding: 0; margin: 0; }
  .company__source { font-size: 12px; color: var(--ink-muted); margin-top: 24px; }
  @media(max-width:600px) { .company { padding-top: 0; padding-bottom: 0; } dl > div { grid-template-columns: 1fr; gap: 8px; padding: 20px 0; } }
</style>
