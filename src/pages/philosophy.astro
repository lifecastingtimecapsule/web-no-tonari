---
// 変更履歴: 2026-11-15 セキュリティ専門への転換に合わせ、事業を守る理念へ改稿。
// 役割: 不安をあおるだけで終わらず、根拠と許可範囲を大切にする姿勢を示す。
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/services.css';
const home=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<SiteLayout title="企業理念｜SITEVEIL" description="大切な仕事を、安心して続けられるように。SITEVEILは、根拠のある検査と分かる言葉で、小さな会社のセキュリティを支えます。">
<div class="philosophy shell"><nav class="philosophy__breadcrumb" aria-label="パンくず"><a href={home}>ホーム</a><span>/</span><span aria-current="page">企業理念</span></nav><h1>企業理念</h1><section class="philosophy__mission"><h2>守りたいのは、<br/>その先にある仕事。</h2><p>一つのサイト、一通のメールの向こうに、お客様との約束がある。長く積み重ねた信頼があり、今日も続いている仕事がある。私たちが守るために向き合うのは、技術だけではありません。</p><p>セキュリティは、大きな会社だけに必要なものではない。それでも、難しい言葉や見えない費用が壁になって、相談することさえ後回しになる。その距離を、少しでも縮めたいと考えています。</p><p>不安を大きくするのではなく、何が分かり、何がまだ分からないのかを明らかにする。問題が見つかれば、その根拠と、次に取り組む順番を伝える。調べて終わりにせず、判断できる形でお渡しする。</p><p>「任せているから大丈夫」の一言に頼らず、確かめた事実を積み重ねる。できないことまで約束せず、許可された範囲を守り、預かった情報を必要以上に残さない。</p><p>大切な仕事を、明日も続けられるように。<br/><strong>そのための備えを、一緒に整える。SITEVEILは、セキュリティに専念します。</strong></p></section></div>
</SiteLayout>
<style>
  .philosophy { max-width: 800px; padding-top: 0; padding-bottom: 0; }
  .philosophy__breadcrumb { display: flex; gap: 14px; align-items: center; margin-bottom: 36px; font-size: 13px; color: var(--ink-muted); }
  h1 { font-size: clamp(1.8rem, 3vw, 2.3rem); line-height: 1.5; padding-bottom: 24px; margin-bottom: 48px; border-bottom: 1px solid var(--mist); }
  .philosophy__mission h2 { font-size: clamp(1.65rem, 3.5vw, 2.7rem); line-height: 1.6; letter-spacing: -.025em; margin-bottom: 28px; }
  .philosophy p { font-size: 16px; line-height: 2; color: var(--ink-muted); max-width: 42em; }
  .philosophy__mission h3 { text-wrap:balance; font-size:clamp(19px,2.6vw,24px);line-height:1.6;margin:36px 0 14px;letter-spacing:-.02em; }
  .philosophy__principles { margin-top: 56px; }
  .philosophy__principles > h2 { font-size: 23px; line-height: 1.5; margin-bottom: 28px; }
  article { padding: 26px 0; border-top: 1px solid var(--mist); }
  article h3 { font-size: 18px; margin: 0 0 12px; }
  article p { margin: 0; }
  @media(max-width:560px) { .philosophy { padding-top: 0; padding-bottom: 0; } h1 { margin-bottom: 32px; }.philosophy__mission h2 { font-size: 1.6rem; }.philosophy__principles { margin-top: 40px; } }
</style>
