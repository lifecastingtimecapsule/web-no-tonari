---
// 変更履歴: 2026-11-08 ユーザー依頼に基づき、誇張のない企業理念を独立した読み物ページとして追加。
// 役割: 事業の目的と基本姿勢を説明する。法人情報・資格・実績は推測して掲載しない。
import '../styles/global.css';
import '../styles/services.css';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const canonical = `https://lifecastingtimecapsule.github.io${home}philosophy/`;
const principles = [
  ['事業を理解する', 'お客様の仕事や目標、現在の課題に耳を傾けます。技術や見た目だけで判断せず、事業にとって何が必要かを考えます。'],
  ['分かりやすく、誠実に伝える', '専門的な内容も、判断しやすい言葉で説明します。対応する内容と費用を事前に整理し、納得して進められる関係を大切にします。'],
  ['使い続けられるかたちにする', '制作時だけでなく、公開後の更新や管理にも目を向けます。お客様自身で運用する場合も、継続して相談する場合も、無理なく続く方法を考えます。'],
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>企業理念｜ウェブのとなり</title>
    <meta name="description" content="身近な技術で、事業の可能性を広げる。ウェブのとなりが大切にする、事業を理解する姿勢、分かりやすい説明、使い続けられる仕組みについて。" />
    <meta property="og:title" content="企業理念｜ウェブのとなり" />
    <meta property="og:description" content="身近な技術で、事業の可能性を広げる。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="service-header shell">
      <a class="brand" href={home}>ウェブのとなり</a>
      <a href={`${home}#services`}>サービス一覧</a>
      <a href={`${home}#contact`}>お問い合わせ</a>
    </header>
    <main id="main" class="philosophy shell">
      <nav class="philosophy__breadcrumb" aria-label="パンくず"><a href={home}>ホーム</a><span aria-hidden="true">/</span><span aria-current="page">企業理念</span></nav>
      <h1>企業理念</h1>
      <section class="philosophy__mission" aria-labelledby="mission-title">
        <h2 id="mission-title">身近な技術で、<br />事業の可能性を広げる。</h2>
        <p>ウェブサイトやアプリ、AIは、日々の仕事に役立ってこそ価値があると考えます。私たちは、お客様の事業と課題を理解し、目的に合った方法を提案します。</p>
        <p>小さな改善から新しい仕組みづくりまで。分かりやすい説明と丁寧な対応を大切にし、安心して活用できる環境を整えます。</p>
      </section>
      <section class="philosophy__principles" aria-labelledby="principles-title">
        <h2 id="principles-title">大切にしていること</h2>
        {principles.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
      </section>
      <div class="philosophy__links"><a href={`${home}#services`}>サービスを見る</a><a href={`${home}#contact`}>お問い合わせ</a></div>
    </main>
    <footer class="service-footer shell"><a href={home}>ウェブのとなり ホームへ</a><span>© 2026 ウェブのとなり</span></footer>
  </body>
</html>
<style>
  .philosophy { max-width: 800px; padding-top: 32px; padding-bottom: 80px; }
  .philosophy__breadcrumb { display: flex; gap: 14px; align-items: center; margin-bottom: 36px; font-size: 13px; color: var(--ink-muted); }
  h1 { font-size: clamp(1.8rem, 3vw, 2.3rem); line-height: 1.5; padding-bottom: 24px; margin-bottom: 48px; border-bottom: 1px solid var(--mist); }
  .philosophy__mission h2 { font-size: clamp(1.65rem, 3.5vw, 2.7rem); line-height: 1.6; letter-spacing: -.025em; margin-bottom: 28px; }
  .philosophy p { font-size: 16px; line-height: 2; color: var(--ink-muted); max-width: 42em; }
  .philosophy__principles { margin-top: 56px; }
  .philosophy__principles > h2 { font-size: 23px; line-height: 1.5; margin-bottom: 28px; }
  article { padding: 26px 0; border-top: 1px solid var(--mist); }
  article h3 { font-size: 18px; margin: 0 0 12px; }
  article p { margin: 0; }
  .philosophy__links { display: flex; flex-wrap: wrap; gap: 16px 36px; padding-top: 32px; margin-top: 20px; border-top: 1px solid var(--mist); font-size: 14px; }
  .philosophy__links a { display: inline-flex; align-items: center; min-height: 44px; }
  @media(max-width:560px) { .philosophy { padding-top: 18px; padding-bottom: 56px; } h1 { margin-bottom: 32px; }.philosophy__mission h2 { font-size: 1.6rem; }.philosophy__principles { margin-top: 40px; } }
</style>
