---
// 変更履歴: 2026-11-11 依頼者の挑戦への思いが伝わる理念へ改稿。困りごとから前向きな解放へつなぎ、対応姿勢を具体化。
// 変更履歴: 2026-11-08 ユーザー依頼に基づき、誇張のない企業理念を独立した読み物ページとして追加。
// 変更履歴: 2026-11-08 会社概要と同じく、フッターと重複する本文末尾のリンク列を撤去。
// 変更履歴: 2026-11-11 抽象的な理念の反復を減らし、依頼時の対応姿勢を短く説明。
// 役割: 事業の目的と基本姿勢を説明する。法人情報・資格・実績は推測して掲載しない。
// 変更履歴: 2026-11-08 運営会社の確認に伴い会社概要への相互導線を追加。
import SiteLayout from '../layouts/SiteLayout.astro';
// 変更履歴: 2026-11-08 共通レイアウトを採用し、トップから移動した際のロゴ・ナビ・書体・フッターの断絶を解消。
import '../styles/services.css';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const principles = [
  ['その仕事の、いちばんの理解者を目指す', '何をつくるかの前に、何を大切にしているのかを聞く。お客様に届けたい価値と、今つまずいていること。その両方から、必要な仕組みを考えます。'],
  ['納得して、一歩を踏み出せるように', '何を頼めて、いくらかかるのか。できることも、難しいことも、分かる言葉で伝える。お客様が自分の意思で選べることを、信頼の出発点にします。'],
  ['つくった先の毎日まで、考える', '日々の仕事で役に立ち、無理なく使い続けられること。公開後の管理や安全への備えも見据え、お客様が仕事に向き合える仕組みをつくります。'],
];
---
<SiteLayout title="企業理念｜SITEVEIL" description="やりたい仕事に、夢中になれる毎日を。SITEVEILは、制作・業務システム・保守を通じて、小さな会社やお店の「もっと、こうしたい」に技術で応えます。">
<div class="philosophy shell">
      <nav class="philosophy__breadcrumb" aria-label="パンくず"><a href={home}>ホーム</a><span aria-hidden="true">/</span><span aria-current="page">企業理念</span></nav>
      <h1>企業理念</h1>
      <section class="philosophy__mission" aria-labelledby="mission-title">
        <h2 id="mission-title">やりたい仕事に、<br />夢中になれる毎日を。</h2>
        <p>届けたい商品がある。喜ばせたいお客様がいる。<br />その思いで始めた仕事なのに、更新できないホームページや、何度も繰り返す入力、見えない安全への不安に、時間も気力も奪われてしまう。</p>
        <p>「もっと、こうしたい。」<br />その気持ちまで、後回しにしてほしくない。</p>
        <p>私たちは、技術の力で、仕事を前に進めたい。<br />事業の魅力が届くサイトをつくる。手間のかかる仕事を、使える仕組みに変える。安心して続けるための備えを考える。</p>
        <p>ひとつ困りごとがほどけたら、次にやりたかったことへ。<br />小さな会社にも、ひとりで挑む人にも、その一歩を踏み出す力があると信じています。</p>
        <p>あなたが、自分の仕事の可能性に、もう一度わくわくできるように。<br />その挑戦に、技術で応える。<br /><strong>それが、SITEVEILの仕事です。</strong></p>
      </section>
      <section class="philosophy__principles" aria-labelledby="principles-title">
        <h2 id="principles-title">この思いを、仕事の姿勢に。</h2>
        {principles.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
      </section>
    </div>
</SiteLayout>
<style>
  .philosophy { max-width: 800px; padding-top: 0; padding-bottom: 0; }
  .philosophy__breadcrumb { display: flex; gap: 14px; align-items: center; margin-bottom: 36px; font-size: 13px; color: var(--ink-muted); }
  h1 { font-size: clamp(1.8rem, 3vw, 2.3rem); line-height: 1.5; padding-bottom: 24px; margin-bottom: 48px; border-bottom: 1px solid var(--mist); }
  .philosophy__mission h2 { font-size: clamp(1.65rem, 3.5vw, 2.7rem); line-height: 1.6; letter-spacing: -.025em; margin-bottom: 28px; }
  .philosophy p { font-size: 16px; line-height: 2; color: var(--ink-muted); max-width: 42em; }
  .philosophy__principles { margin-top: 56px; }
  .philosophy__principles > h2 { font-size: 23px; line-height: 1.5; margin-bottom: 28px; }
  article { padding: 26px 0; border-top: 1px solid var(--mist); }
  article h3 { font-size: 18px; margin: 0 0 12px; }
  article p { margin: 0; }
  @media(max-width:560px) { .philosophy { padding-top: 0; padding-bottom: 0; } h1 { margin-bottom: 32px; }.philosophy__mission h2 { font-size: 1.6rem; }.philosophy__principles { margin-top: 40px; } }
</style>
