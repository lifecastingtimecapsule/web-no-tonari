---
// 変更履歴: 2026-11-11 保存しない無料メール漏えい履歴チェックを追加。サイトURLの安全確認とは別に案内。
// 変更履歴: 2026-11-11 調査ツールとしての説明へ整理し、入力までの余白を短縮。提供元は利用条件に従い末尾に控えめに表示。
// 役割: 同意したメールアドレスの公開漏えい記録を、サービス名・日付・情報の種類で日本語表示する。
import SiteLayout from '../layouts/SiteLayout.astro';
const home=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<SiteLayout title="無料メール漏えいチェック・サービス名と日付を確認｜SITEVEIL" description="メールアドレスを入力し、既知の漏えい記録にあるサービス名・発生時期・情報の種類を日本語で確認。オンラインの詳細結果は無料。メールアドレスと結果をSITEVEILに保存しません。">
<div class="shell email-check">
  <nav class="page-breadcrumb" aria-label="パンくず"><a href={home}>ホーム</a><span aria-hidden="true">/</span><span aria-current="page">メール漏えいチェック</span></nav>
  <header><p class="email-check__label">無料・登録不要</p><h1>そのメールに、<br />漏えいの記録は。</h1><p>SITEVEIL独自の照合・整理ツールで、漏えいしたサービス・時期・情報を確認。</p></header>
  <form data-breach-form data-api={`${home}api/breach-check`} novalidate>
    <label class="email-check__field" for="breach-email">メールアドレス</label>
    <div class="email-check__entry"><input id="breach-email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" placeholder="you@example.com" maxlength="254" required aria-describedby="breach-privacy breach-status" /><button type="submit">無料で調べる<span aria-hidden="true">↗</span></button></div>
    <label class="email-check__consent"><input type="checkbox" name="consent" required /><span>本人、または調査の許可を得たメールアドレスです。外部データベースへの照会に同意します。</span></label>
    <p id="breach-privacy" class="email-check__privacy">メールアドレスと結果はSITEVEILに保存しません。パスワードの入力は不要です。</p>
    <div class="email-check__trap" aria-hidden="true"><label>入力しないでください<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <p id="breach-status" class="email-check__status" role="status" aria-live="polite" data-breach-status></p>
  </form>
  <section class="email-check__results" aria-labelledby="breach-result-title" data-breach-results hidden>
    <h2 id="breach-result-title" tabindex="-1" data-breach-title></h2><p class="email-check__checked" data-breach-checked></p><p class="email-check__notice" data-breach-notice></p><div class="email-check__records" data-breach-records></div>
  </section>
  <details class="email-check__scope"><summary>調査範囲と注意事項</summary><p>既知の公開漏えい記録への照会です。見つからなくても、漏えいしていないことを保証しません。日付や項目が取得できない記録は「不明」と表示します。日付は照会元の記録で、企業の公表日や実際の発生時期と異なることがあります。</p><p>「パスワード」はその事案に含まれた情報の種類です。現在のパスワードが漏えいしたことや、ログイン可能であることを示すものではありません。本人確認が必要な非公開・機微な事案は対象外です。</p><p>サービス全体の利用枠が混み合う場合は、一部の照会ができないことがあります。接続できなかった照会元は結果に明記します。</p><p>照会のため、入力したメールアドレスを各サービスに送信します。照会元での取扱いは各サービスの条件に従います。</p></details>
  <p class="email-check__postal">紙で残したい方へ。<a href={`${home}pricing/#email-breach-check`}>郵送報告書は3,300円（税込・国内送料込み）</a>で準備しています。</p>
  <p class="email-check__credit">データ提供：<a href="https://haveibeenpwned.com/" target="_blank" rel="noopener noreferrer">Have I Been Pwned</a>・<a href="https://xposedornot.com/" target="_blank" rel="noopener noreferrer">XposedOrNot</a></p>
</div>
</SiteLayout>
<script>import '../scripts/breach-check';</script>
<style>
.email-check{max-width:880px;padding-bottom:0}.page-breadcrumb{display:flex;gap:14px;font-size:12px;margin-bottom:24px}.email-check header{margin-bottom:24px}.email-check__label{font-size:13px;color:var(--ink-muted)}h1{font-size:clamp(32px,4.5vw,52px);line-height:1.2;letter-spacing:-.03em;margin:8px 0 16px}.email-check header>p:last-child{color:var(--ink-muted);font-size:16px}.email-check__field{display:block;margin-bottom:12px;font-size:14px;font-weight:700}.email-check__entry{display:flex;gap:12px}.email-check__entry input{flex:1;min-width:0;min-height:58px;padding:12px 16px;border:1px solid #919a94;border-radius:0;background:#fff;font:inherit}.email-check__entry button{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:58px;padding:12px 24px;border:0;background:#16191d;color:#fff;font:inherit;font-weight:700;cursor:pointer;touch-action:manipulation}.email-check__entry button:disabled{opacity:.6;cursor:wait}.email-check__entry button:hover:not(:disabled){background:#333}.email-check__consent{display:flex;align-items:flex-start;gap:10px;margin-top:16px;font-size:13px;line-height:1.8;cursor:pointer}.email-check__consent input{flex:none;width:19px;height:19px;margin-top:3px;accent-color:#16191d}.email-check__privacy,.email-check__checked,.email-check__postal{color:var(--ink-muted);font-size:12px;line-height:1.9}.email-check__trap{display:none}.email-check__status{font-size:14px;margin:12px 0}.email-check__status:empty{display:none}.email-check__credit{font-size:12px;line-height:1.8;color:var(--ink-muted);margin:16px 0 0}.email-check__status[data-error]{color:#b42318}.email-check__results{margin-top:48px}.email-check__results h2{font-size:clamp(22px,3vw,32px);line-height:1.5}.email-check__notice{font-size:14px;color:#6e4514}.email-check__records{margin-top:24px}.email-check__scope{margin-top:24px;padding:12px 0;border-top:1px solid #e4e8e5}.email-check__scope summary{font-size:14px;font-weight:700;cursor:pointer;min-height:30px}.email-check__scope p{font-size:13px;line-height:1.9;color:var(--ink-muted)}input:focus-visible,button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--signal);outline-offset:4px}@media(max-width:600px){.email-check__entry{flex-direction:column}.email-check__entry button{width:100%}.page-breadcrumb{margin-bottom:20px}.email-check__results{margin-top:32px}}
</style>
<style is:global>
/* 役割: 外部HTMLを使わずに生成する結果カードへ、共通の日本語レイアウトを適用。 */
/* 変更履歴: 2026-11-11 記録ごとに日付・情報の丸印・注記を分離し、長いサービス名のはみ出しを防止。 */
.breach-record{padding:26px 0;border-top:1px solid #e2e7e3;overflow-wrap:anywhere}.breach-record h3{font-size:23px;margin:0 0 14px;line-height:1.4}.breach-record__date{font-size:14px;margin:0 0 18px;color:#465359}.breach-record__fields{display:flex;flex-wrap:wrap;gap:8px 18px;padding:0;margin:0;list-style:none}.breach-record__fields li{font-size:14px}.breach-record__fields li::before{content:'●';margin-right:7px;color:#df2033;font-size:11px}.breach-record__note{margin:16px 0 0;font-size:12px;color:#65716a;line-height:1.8}.breach-record__sources{font-size:11px;color:#65716a;margin-top:16px}
</style>
