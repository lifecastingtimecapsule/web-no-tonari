---
// 変更履歴: 2026-11-23 無料診断を1ページに統合。サイト診断とメール漏えい診断を同じ画面で使えるようにした。
// 役割: 複数の無料診断の入口を1か所にまとめ、有料の検査・相談へつなぐ。
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteCheckTool from '../components/SiteCheckTool.astro';
import EmailCheckTool from '../components/EmailCheckTool.astro';
import '../styles/catalog.css';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<SiteLayout title="無料のサイト・メール安全チェック｜SITEVEIL" description="サイトURLとメールアドレスから、通信の暗号化・保護設定・公開ファイル・WordPress・ドメインの漏えい履歴を無料で確認できます。登録不要。">
  <div class="shell catalog-page free-tools">
    <nav class="page-breadcrumb" aria-label="パンくず"><a href={home}>ホーム</a><span aria-hidden="true">/</span><span aria-current="page">無料チェック</span></nav>
    <header class="catalog-heading">
      <h1>無料でできる安全チェック</h1>
      <p>サイトとメールの診断を、このページでまとめて確認できます。無料・登録不要。</p>
    </header>
    <nav class="free-tools__index" aria-label="診断ツール">
      <a href="#site">サイトの安全チェック</a>
      <a href="#email">メール漏えいチェック</a>
    </nav>
  </div>
  <section id="site" class="free-tools__tool">
    <SiteCheckTool />
  </section>
  <section id="email" class="free-tools__tool">
    <EmailCheckTool />
  </section>
</SiteLayout>
<style is:global>
  .free-tools__index { display: flex; flex-wrap: wrap; gap: 12px; }
  .free-tools__index a { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 18px; border: 1px solid var(--mist); border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 700; }
  .free-tools__index a:hover { border-color: var(--signal); color: var(--signal); }
  .free-tools__tool { scroll-margin-top: 120px; }
  #email { margin-top: 72px; padding-top: 56px; border-top: 1px solid var(--mist); }
  @media (max-width: 800px) { #email { margin-top: 48px; padding-top: 40px; } }
</style>
