---
// 変更履歴: 2026-11-04 承認済みのブランドストーリーと全ページ構成を初回実装。
// 変更履歴: 2026-11-05 ヒーローに装飾3Dキャンバスと既存SVGフォールバックの受け口を追加。
// 変更履歴: 2026-11-05 シネマティック・テック案の単一3Dコア、短いコピー、非対称構成へヒーローを再設計。
// 変更履歴: 2026-11-08 白黒赤ヒーローと社内制作事例へ置換し、実画面を主役にする。
// 変更履歴: 2026-11-08 YAYOI SAIGA事例を外し、HiXFiを参考にしたサービス起点の導線へ再整理。
import '../styles/global.css';
import OpeningHero from '../components/OpeningHero.astro';
// 変更履歴: 2026-11-08 4サービスへの詳細・体験導線を追加し、ECを含む提供領域を統一。
// 変更履歴: 2026-11-08 サービスをサンプル画面・短い説明付きの横並びカラムへ変更し、完成像を比較しやすくする。
// 変更履歴: 2026-11-08 スクロール連動の赤い大見出しを追加し、相談欄を本文＋任意URLとコピー操作へ簡略化。
// 変更履歴: 2026-11-08 再指示により問い合わせ前の動く文字帯を撤去し、一般的な問い合わせ見出しへ変更。
// 変更履歴: 2026-11-08 サービスを3件ずつ見せる手動横送りへ変更。全4件を左右ボタン・スワイプで閲覧できる。
// 変更履歴: 2026-11-08 独立した企業理念ページへのリンクをフッターへ追加。
// 変更履歴: 2026-11-08 確認済み運営会社と会社概要への導線をフッターに追加。
import { servicePages } from '../data/services';
const serviceBase = import.meta.env.BASE_URL.replace(/\/$/, '');

const concerns = [
  {
    id: 'maintain',
    label: '更新や管理が止まっている',
    title: '日々の小さな更新から、安心して任せられる状態へ。',
    body: 'まず現在の環境と更新方法を確認します。必要な保守範囲を整理し、無理なく続けられる運用を一緒につくります。',
    service: 'ホームページ保守・更新',
  },
  {
    id: 'renew',
    label: '古くなったサイトを見直したい',
    title: '見た目だけでなく、役割からつくり直す。',
    body: '誰に何を伝え、どんな相談につなげるかを整理します。いまある内容を活かしながら、必要な範囲から更新します。',
    service: 'ホームページリニューアル',
  },
  {
    id: 'ai',
    label: 'AIを仕事に活かしたい',
    title: 'AIを入れることではなく、仕事が少し楽になることから。',
    body: '文章作成、問い合わせ整理、情報検索など、現場で繰り返している作業を確認し、小さく試せる方法を提案します。',
    service: 'AI活用・アプリ提案',
  },
  {
    id: 'security',
    label: '安全性に不安がある',
    title: '見えない不安を、確認できる項目へ変える。',
    body: 'サイト、更新環境、権限、バックアップなどを確認し、すぐ対応することと、今後整えることを分けてご案内します。',
    service: 'セキュリティ診断',
  },
];

const faqs = [
  ['相談内容がまとまっていなくても大丈夫ですか？', 'はい。何を頼めばよいか分からない段階から、困っていることと優先順位を一緒に整理します。'],
  ['小さな修正だけでも相談できますか？', '現在のサイトや運用状況を確認したうえで、対応できる範囲をご案内します。大きなリニューアルを前提にはしません。'],
  ['AIを導入すれば、すぐに業務を自動化できますか？', '業務内容や扱う情報によって異なります。まず小さな作業で試し、安全性と効果を確認してから範囲を広げます。'],
  ['セキュリティ診断では何を確認しますか？', '初期段階では、サイトやCMSの更新状況、権限、パスワード運用、バックアップなどの基本項目を想定しています。正式な診断範囲は相談後に明示します。'],
  ['料金や対応地域は決まっていますか？', 'ウェブサイト制作、保守、基本セキュリティ確認の固定料金は掲載しています。対象外の作業は、必ず開始前に金額と内容をご案内します。対応地域やオンラインでの進め方は、ご相談内容に合わせてお伝えします。'],
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ウェブ保守、ホームページのリニューアル、AI活用、セキュリティ診断を、小さなチームならではの距離感で支援するウェブのとなり。" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2216%22 fill=%22%230b1730%22/><path d=%22M10 40c10 0 10-20 22-20s12 20 22 20%22 fill=%22none%22 stroke=%22%233468f5%22 stroke-width=%226%22 stroke-linecap=%22round%22/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@500;600;700;900&display=swap" rel="stylesheet" />
    <title>ウェブのとなり｜小さく近い、ウェブとAIの伴走者</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="ウェブのとなり ホームへ">
        <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M5 27C11 27 11 13 20 13s9 14 15 14" />
          <circle cx="5" cy="27" r="2.5" />
          <circle cx="35" cy="27" r="2.5" />
        </svg>
        <span>ウェブのとなり</span>
      </a>

      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-button>
        <span class="menu-button__label">メニュー</span>
        <span class="menu-button__lines" aria-hidden="true"></span>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="メインナビゲーション" data-nav>
        <a href="#services">できること</a>
        <a href="#pricing">料金</a>
        <a href="#faq">よくある質問</a>
        <a class="nav-contact" href="#contact">相談する</a>
      </nav>
    </header>

    <main id="main">
      <OpeningHero />

      <section class="declaration section section--paper" aria-labelledby="declaration-title">
        <div class="shell declaration__grid">
          <h2 id="declaration-title">速く答えることより、<br />近くで考えること。</h2>
          <div class="declaration__body">
            <p>AIやウェブがどれだけ便利になっても、会社ごとに悩みも、必要な答えも違います。</p>
            <p>小さなチームだからこそ、話を途中で手放さない。一つひとつの仕事を知り、その会社に合う方法を一緒に考えます。</p>
          </div>
        </div>
      </section>

      <section class="concerns section" id="concerns" aria-labelledby="concerns-title">
        <div class="conversation-rail" aria-hidden="true">
          <span class="conversation-rail__track"></span>
          <span class="conversation-rail__fill" data-rail-fill></span>
        </div>

        <div class="shell concerns__layout">
          <div class="section-heading">
            <h2 id="concerns-title">いま、何に困っていますか。</h2>
            <p>相談内容がまとまっていなくても大丈夫です。近いものを一つ選ぶと、考え方の入口が変わります。</p>
          </div>

          <div class="concern-tool" data-concern-tool>
            <div class="concern-tool__choices" role="group" aria-label="困りごとを選ぶ">
              {concerns.map((concern, index) => (
                <button
                  class="concern-choice"
                  type="button"
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  data-concern={concern.id}
                >
                  <span class="concern-choice__dot" aria-hidden="true"></span>
                  {concern.label}
                </button>
              ))}
            </div>

            <div class="concern-tool__result" aria-live="polite" aria-atomic="true">
              <p class="concern-tool__service" data-concern-service>{concerns[0].service}</p>
              <h3 data-concern-title>{concerns[0].title}</h3>
              <p data-concern-body>{concerns[0].body}</p>
              <a class="text-link" href="#contact">この内容を相談する</a>
            </div>
          </div>
        </div>
      </section>

      <section class="services section section--mist" id="services" aria-labelledby="services-title">
        <div class="shell">
          <div class="section-heading section-heading--wide">
            <h2 id="services-title">つくる、守る、育てるを、<br />ひとつの相談先で。</h2>
            <p>必要なものだけを、必要な順序で。大きな仕組みを売ることから始めません。</p>
          </div>

          <div class="service-carousel-controls" data-service-controls hidden>
            <p role="status" aria-live="polite" aria-atomic="true" data-service-position>全4サービス</p>
            <div>
              <button type="button" aria-label="前のサービスを表示" aria-controls="service-carousel" data-service-prev disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
              <button type="button" aria-label="次のサービスを表示" aria-controls="service-carousel" data-service-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
            </div>
          </div>
          <div class="service-list" id="service-carousel" data-service-list tabindex="0" role="region" aria-label="サービス一覧。横にスクロールして閲覧できます">
            {servicePages.map((service) => (
              <article class="service-row">
                <a class="service-row__preview" href={`${serviceBase}/services/${service.slug}/`} aria-label={`${service.name}のサンプルを見る`}>
                  <img src={`${serviceBase}/images/services/${service.slug}.png`} alt={`${service.name}の体験サンプル画面`} width="900" height="680" loading="lazy" decoding="async" />
                  <span>体験サンプル</span>
                </a>
                <h3><a href={`${serviceBase}/services/${service.slug}/`}>{service.name}</a></h3>
                <p class="service-row__summary">{service.preview}</p>
                <a class="text-link service-row__detail" href={`${serviceBase}/services/${service.slug}/`}>サンプルと詳しい内容を見る</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="pricing section section--paper" id="pricing" aria-labelledby="pricing-title">
        <div class="shell">
          <div class="pricing__heading">
            <p class="pricing__kicker">PRICE / TAX INCLUDED</p>
            <h2 id="pricing-title">料金は、先に決める。<br />後から増やさない。</h2>
            <p>必要なものだけを選べる固定料金です。表に書いた範囲なら、追加請求はありません。</p>
          </div>

          <div class="pricing__primary" aria-label="基本料金">
            <article class="pricing__primary-item">
              <p>ウェブサイト制作</p>
              <strong>¥110,000</strong>
              <span>5ページまで／スマホ対応／問い合わせフォーム／基本SEO設定</span>
            </article>
            <article class="pricing__primary-item">
              <p>基本保守</p>
              <strong>¥9,800<small> / 月</small></strong>
              <span>バックアップ／更新状況の確認／基本相談</span>
            </article>
            <article class="pricing__primary-item">
              <p>基本セキュリティ確認</p>
              <strong>¥55,000</strong>
              <span>CMS・権限・更新・バックアップ・フォーム・HTTPSの確認</span>
            </article>
          </div>

          <div class="pricing__options">
            <div>
              <h3>必要なときだけ、追加する。</h3>
              <p>保守契約や更新契約は必須ではありません。納品後はご自身で更新しても、他社へ依頼しても大丈夫です。</p>
            </div>
            <dl class="pricing__option-list">
              <div><dt>追加ページ</dt><dd>¥15,000 / 1ページ</dd></div>
              <div><dt>お知らせ更新機能</dt><dd>¥33,000</dd></div>
              <div><dt>英語ページ</dt><dd>¥12,000 / 1ページ</dd></div>
              <div><dt>軽微な更新を月2回追加</dt><dd>+¥10,000 / 月</dd></div>
              <div><dt>安全性の定期確認</dt><dd>+¥5,000 / 月</dd></div>
              <div><dt>月次レポート</dt><dd>+¥3,000 / 月</dd></div>
            </dl>
          </div>

          <p class="pricing__external">ドメイン、サーバー、有料APIなどの外部費用は実費です。手数料はいただきません。</p>
          <a class="pricing__cta" href="#contact">この内容を相談する <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="security section" aria-labelledby="security-title" data-security-motion>
        <div class="security__line" aria-hidden="true"></div>
        <div class="shell security__layout">
          <div>
            <h2 id="security-title">AI時代の便利さと、<br />新しいリスクに備える。</h2>
            <p>AIを悪用した偽メールやなりすまし、古いホームページの脆弱性。怖がらせるのではなく、確認できる項目と優先順位へ変えます。</p>
            <p class="security__diagnostic"><strong>必要な場合は、有料のセキュリティ診断へ。</strong><span>サイトの構成、更新状況、権限、バックアップなどを確認し、対応範囲と費用を先にご案内します。</span></p>
          </div>
          <ul class="security__checks">
            <li><span aria-hidden="true"></span>CMS・プラグインの更新状況</li>
            <li><span aria-hidden="true"></span>権限・パスワード・バックアップ</li>
            <li><span aria-hidden="true"></span>問い合わせフォームと通信</li>
            <li><span aria-hidden="true"></span>AI利用時の情報管理</li>
          </ul>
        </div>
      </section>

      <section class="faq section section--paper" id="faq" aria-labelledby="faq-title">
        <div class="shell faq__layout">
          <div class="section-heading">
            <h2 id="faq-title">相談の前によくあること。</h2>
            <p>正式なサービス範囲はこれから整備します。現時点で決まっていないことも、そのままお伝えします。</p>
          </div>
          <div class="faq-list">
            {faqs.map(([question, answer]) => (
              <details>
                <summary>{question}<span aria-hidden="true"></span></summary>
                <div class="faq-list__answer"><p>{answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="contact section" id="contact" aria-labelledby="contact-title">
        <div class="shell contact__layout">
          <div class="contact__intro">
            <h2 id="contact-title">お問い合わせ</h2>
            <p>ご相談・ご質問をお書きください。</p>
            <p class="contact__demo-note">メールの受付先を準備中です。いまは相談内容をコピーして保存できます。外部へは送信されません。</p>
          </div>

          <form class="contact-form" data-contact-form novalidate>
            <div class="field">
              <label for="message">相談したいこと</label>
              <textarea id="message" name="message" rows="5" required aria-describedby="message-help message-error" placeholder="例：お店のホームページを作り直したいです…"></textarea>
              <p class="field__help" id="message-help">短い文章で大丈夫です。</p>
              <p class="field__error" id="message-error" data-error-for="message"></p>
            </div>
            <details class="contact-form__optional">
              <summary>サイトのURLを添える（任意）</summary>
              <div class="field">
                <label for="site-url">サイトのURL</label>
                <input id="site-url" name="siteUrl" type="url" inputmode="url" autocomplete="url" spellcheck="false" aria-describedby="site-url-error" placeholder="https://example.com…" />
                <p class="field__error" id="site-url-error" data-error-for="siteUrl"></p>
              </div>
            </details>
            <button class="button button--human" type="submit" data-submit-button>
              <span data-submit-label>相談内容をコピーする</span>
              <span class="button__spinner" aria-hidden="true"></span>
            </button>
            <div class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status></div>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <a class="brand brand--footer" href="#top">
          <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M5 27C11 27 11 13 20 13s9 14 15 14" />
            <circle cx="5" cy="27" r="2.5" />
            <circle cx="35" cy="27" r="2.5" />
          </svg>
          <span>ウェブのとなり</span>
        </a>
        <p>技術が大きくなる時代に、小さく近くいる。</p>
        <p class="site-footer__provisional"><a href={`${serviceBase}/company/`}>会社概要</a>　<a href={`${serviceBase}/philosophy/`}>企業理念</a></p>
        <p><small>運営：株式会社ライフキャスティングジャパン</small></p>
      </div>
    </footer>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
